{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "description": "String / Text Component of Game",
      "$ref": "properties/text.json"
    },
    "subtitle": {
      "$ref": "properties/text.json"
    },
    "icon": {
      "type": "string"
    },
    "intro_slideshow": {
      "type": "string"
    },
    "minimum_participants": {
      "type": "integer",
      "minimum": 1
    },
    "maximum_participants": {
      "type": "integer"
    },
    "is_multi_game": {
      "type": "boolean"
    },
    "hide_from_list": {
      "type": "boolean"
    },
    "waiting": {
      "type": "object",
      "properties": {
        "map": {
          "$ref": "properties/map.json"
        },
        "behaviors": {
          "$ref": "behaviors/behaviors.json"
        }
      },
      "required": [
        "map",
        "behaviors"
      ]
    },
    "map": {
      "$ref": "properties/map.json"
    },
    "behaviors": {
      "$ref": "behaviors/behaviors.json"
    }
  },
  "required": [
    "name",
    "map",
    "behaviors"
  ]
}
