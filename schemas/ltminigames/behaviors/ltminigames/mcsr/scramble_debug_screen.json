{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "const": "ltminigames:mcsr/scramble_debug_screen"
    },
    "modifier": {
      "type": "string"
    },
    "shuffle_level": {
      "type": "integer",
      "minimum": 1
    },
    "swap_sides_level": {
      "type": "integer",
      "minimum": 1
    },
    "fake_lines_per_level": {
      "type": "number",
      "minimum": 0
    },
    "garble_chance_per_level": {
      "type": "number",
      "minimum": 0
    },
    "rescramble_chance_per_level": {
      "type": "number",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "modifier"
  ]
}
