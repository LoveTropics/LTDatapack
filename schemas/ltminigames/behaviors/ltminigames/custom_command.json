{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "const": "ltminigames:custom_command"
    },
    "path": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permission_level": {
      "type": "string",
      "enum": [
        "overlord",
        "admin",
        "everyone"
      ]
    },
    "argument": {
      "type": "string",
      "enum": [
        "none",
        "player"
      ]
    },
    "actions": {
      "$ref": "https://raw.githubusercontent.com/LoveTropics/LTDatapack/refs/heads/lt26/schemas/ltminigames/properties/actions.schema.json"
    }
  },
  "required": [
    "type"
  ],
  "additionalProperties": false
}
