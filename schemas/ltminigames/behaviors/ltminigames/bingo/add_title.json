{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "const": "ltminigames:bingo/add_tile"
    },
    "icon": {
      "type": "object",
      "properties": {
        "id": {
          "type": ["string"]
        }
      }
    },
    "title": {
      "$comment": "TODO - FIX"
    },
    "item": {
      "$ref": "../../../properties/items.json"
    },
    "reward": {
      "type": ["integer", "string"],
      "pattern": "^\\$.*"
    },
    "criteria": {
      "$comment": "Advancement criteria that complete the tile",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "trigger": {
            "type": "string"
          },
          "conditions": {
            "type": "object"
          }
        },
        "required": [
          "trigger"
        ]
      }
    },
    "requirements": {
      "$comment": "Which criteria must be met (like advancements)",
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "type"
  ]
}
