{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "const": "ltminigames:tropic_rush/bouncy_ground"
    },
    "modifier": {
      "type": "string"
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "min_fall_distance": {
            "type": "number",
            "minimum": 0
          },
          "bounciness": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "fall_damage_multiplier": {
            "type": "number",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "bounciness"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "modifier",
    "levels"
  ]
}
