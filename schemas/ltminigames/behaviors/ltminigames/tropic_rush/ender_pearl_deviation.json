{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "const": "ltminigames:tropic_rush/ender_pearl_deviation"
    },
    "modifier": {
      "type": "string"
    },
    "max_degrees": {
      "type": "number",
      "minimum": 0,
      "maximum": 180,
      "$comment": "Deviation at the max level of the modifier"
    },
    "growth": {
      "type": "number",
      "minimum": 1,
      "$comment": "How many times more each level deviates than the one below, defaults to 2"
    }
  },
  "additionalProperties": false,
  "required": [
    "type",
    "modifier",
    "max_degrees"
  ]
}
