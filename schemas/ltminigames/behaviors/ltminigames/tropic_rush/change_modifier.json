{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "type": {
      "const": "ltminigames:tropic_rush/change_modifier"
    },
    "modifier": {
      "type": "string",
      "$comment": "Leave out to change a random modifier that the amount would change, e.g. one below its max level"
    },
    "amount": {
      "type": "integer"
    },
    "per_donated_amount": {
      "type": "number"
    }
  },
  "additionalProperties": false,
  "required": [
    "type"
  ]
}
