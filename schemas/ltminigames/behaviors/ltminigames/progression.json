{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "string",
      "const": "ltminigames:progression"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "ltminigames:progression"
        },
        "named_points": {
          "type": "object",
          "additionalProperties": {
            "type": ["number", "string"],
            "pattern": "^\\$.*"
          }
        },
        "channel": {
          "type": "string"
        },
        "start": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    }
  ]
}
