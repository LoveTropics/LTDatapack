{
  "organiser": {
    "includes": ["administration"],
    "overrides": {
      "name_decoration": {
        "bypass_whitelist": true,
        "style": "#2ecc71"
      }
    }
  },
  "live": {
    "includes": ["host"],
    "overrides": {
      "name_decoration": {
        "prefix": {
          "text": "▶ ",
          "color": "red"
        },
        "style": "#e91e63"
      },
      "host": true,
      "waypoint_icon": {
        "style": "lt:host",
        "color": [1.0, 0.2, 0.0]
      }
    }
  },
  "host": {
    "overrides": {
      "bypass_whitelist": true,
      "name_decoration": {
        "style": "#e91e63"
      },
      "commands": {
        "fly": "allow",
        "gamemode": "allow"
      }
    }
  },
  "mojangsta": {
    "includes": ["trusted"],
    "overrides": {
      "bypass_whitelist": true,
      "name_decoration": {
        "style": "#d84283"
      }
    }
  },
  "modder": {
    "includes": ["trusted", "administration"],
    "overrides": {
      "bypass_whitelist": true,
      "name_decoration": {
        "style": "#DEB22F"
      }
    }
  },
  "administration": {
    "overrides": {
      "op_level": 4,
      "bypass_whitelist": true,
      "commands": {
        ".*": "allow"
      }
    }
  },
  "builder": {
    "includes": ["fake_op"],
    "overrides": {
      "bypass_whitelist": true,
      "name_decoration": {
        "style": "#a95cdd"
      }
    }
  },
  "helper": {
    "overrides": {
      "name_decoration": {
        "style": "#30f0a7"
      }
    }
  },
  "fake_op": {
    "overrides": {
      "op_level": 2,
      "worldedit_allowed": true,
      "commands": {
        "/.*": "allow",
        "/regen .*": "deny",
        "map join .*": "allow",
        "map leave .*": "allow",
        "fly": "allow",
        "give": "allow",
        "gamemode .*": "allow",
        "clear": "allow",
        "tp .*": "allow"
      }
    }
  },
  "moderator": {
    "bypass_whitelist": true,
    "includes": ["moderation"],
    "overrides": {
      "name_decoration": {
        "style": "#3498db"
      }
    }
  },
  "trusted": {
    "includes": ["moderation"],
    "overrides": {
      "commands": {
        "fly": "allow",
        "give": "allow",
        "game": "allow",
        "gamemode .*": "allow",
        "tp": "allow"
      }
    }
  },
  "moderation": {
    "overrides": {
      "commands": {
        "kick": "allow",
        "ban": "allow",
        "ban-ip": "allow",
        "pardon": "allow",
        "pardon-ip": "allow",
        "banlist": "allow",
        "unban": "allow"
      }
    }
  },
  "build_mode": {
    "overrides": {
      "commands": {
        "fly": "allow"
      }
    }
  },
  "in_tutorial": {
    "overrides": {
      "commands": {
        ".*": "deny"
      }
    }
  },
  "dinners": {},
  "river_race_red": {},
  "river_race_blue": {},
  "everyone": {
    "overrides": {
      "commands": {
        "help": "allow",
        "game join": "allow",
        "game spectate": "allow",
        "game play": "allow",
        "game leave": "allow",
        "game register": "allow",
        "me": "allow",
        "w": "allow",
        "tell": "allow",
        "msg": "allow",
        "chat": "allow",
        "shout": "allow",
        "spawnitems": "allow",
        "tpa": "allow",
        "tpaccept": "allow",
        "warp": "allow",
        "tools": "allow",
        "about": "allow",
        "spawn": "allow",
        "admin": "deny",
        "config": "deny",
        "((?!title|tellraw|give).)*": "deny"
      },
      "command_feedback": false
    }
  },
  "commander": {
    "overrides": {
      "command_feedback": true
    }
  }
}
