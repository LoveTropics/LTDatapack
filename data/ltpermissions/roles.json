{
  "organiser": {
    "includes": ["administration"],
    "overrides": {
      "name_decoration": {
        "style": "#2ecc71"
      }
    }
  },
  "alt_account": {
    "includes": ["administration"],
    "overrides": {
      "name_decoration": {
        "prefix": {
          "text": "[ALT] ",
          "color": "red"
        },
        "style": "#31a2ac"
      }
    }
  },
  "live": {
    "includes": ["host"],
    "overrides": {
      "name_decoration": {
        "prefix": {
          "text": "▶ ",
          "color": "red"
        },
        "style": "#e91e63"
      },
      "host": true,
      "waypoint_icon": {
        "style": "lt:host",
        "color": [1.0, 0.2, 0.0]
      }
    }
  },
  "host": {
    "includes": ["whitelisted"],
    "overrides": {
      "name_decoration": {
        "style": "#e91e63"
      },
      "commands": {
        "fly": "allow",
        "gamemode": "allow"
      }
    }
  },
  "mojangsta": {
    "includes": ["trusted"],
    "overrides": {
      "name_decoration": {
        "style": "#d84283"
      }
    }
  },
  "modder": {
    "includes": ["trusted", "administration"],
    "overrides": {
      "name_decoration": {
        "style": "#DEB22F"
      }
    }
  },
  "administration": {
    "includes": ["whitelisted"],
    "overrides": {
      "op_level": 4,
      "commands": {
        ".*": "allow"
      }
    }
  },
  "builder": {
    "includes": ["fake_op", "whitelisted"],
    "overrides": {
      "join_access": {
        "allows_joining": true
      },
      "name_decoration": {
        "style": "#a95cdd"
      }
    }
  },
  "helper": {
    "includes": ["whitelisted"],
    "overrides": {
      "name_decoration": {
        "style": "#30c6f0"
      },
      "join_access": {
        "allows_joining": true
      }
    }
  },
  "fake_op": {
    "includes": ["whitelisted"],
    "overrides": {
      "op_level": 2,
      "worldedit_allowed": true,
      "commands": {
        "/.*": "allow",
        "/regen .*": "deny",
        "map join .*": "allow",
        "map leave .*": "allow",
        "fly": "allow",
        "give": "allow",
        "gamemode .*": "allow",
        "clear": "allow",
        "tp .*": "allow",
        "effect": "allow"
      },
      "join_access": {
        "allows_joining": true
      }
    }
  },
  "moderator": {
    "includes": ["moderation"],
    "overrides": {
      "name_decoration": {
        "style": "#3498db"
      }
    }
  },
  "trusted": {
    "includes": ["moderation"],
    "overrides": {
      "commands": {
        "fly": "allow",
        "give": "allow",
        "game": "allow",
        "gamemode .*": "allow",
        "tp": "allow"
      }
    }
  },
  "moderation": {
    "includes": ["whitelisted"],
    "overrides": {
      "commands": {
        "kick": "allow",
        "ban": "allow",
        "ban-ip": "allow",
        "pardon": "allow",
        "pardon-ip": "allow",
        "banlist": "allow",
        "unban": "allow"
      }
    }
  },
  "build_mode": {
    "overrides": {
      "commands": {
        "fly": "allow"
      }
    }
  },
  "in_tutorial": {
    "overrides": {
      "commands": {
        ".*": "deny"
      }
    }
  },
  "dinners": {},
  "river_race_red": {},
  "river_race_blue": {},
  "everyone": {
    "overrides": {
      "commands": {
        "help": "allow",
        "game join": "allow",
        "game spectate": "allow",
        "game play": "allow",
        "game leave": "allow",
        "game register": "allow",
        "me": "allow",
        "w": "allow",
        "tell": "allow",
        "msg": "allow",
        "chat": "allow",
        "shout": "allow",
        "spawnitems": "allow",
        "tpa": "allow",
        "tpaccept": "allow",
        "warp": "allow",
        "tools": "allow",
        "about": "allow",
        "spawn": "allow",
        "admin": "deny",
        "config": "deny",
        "((?!title|tellraw|give).)*": "deny"
      },
      "command_feedback": false,
      "join_access": {
        "allows_joining": false
      }
    }
  },
  "commander": {
    "overrides": {
      "command_feedback": true
    }
  },
  "event_streamer": {
    "includes": ["whitelisted"],
    "overrides": {
      "name_decoration": {
        "prefix": {
          "text": "[STREAMER] ",
          "color": "#F5A927"
        },
        "style": "#F5A927"
      }
    }
  },
  "event": {
    "overrides": {
      "commands": {
        "help": "allow",
        "game join": "allow",
        "game spectate": "allow",
        "game play": "allow",
        "game leave": "allow",
        "game register": "allow",
        "me": "allow",
        "w": "allow",
        "tell": "allow",
        "msg": "allow",
        "chat": "allow",
        "shout": "allow",
        "spawnitems": "deny",
        "tpa": "deny",
        "tpaccept": "deny",
        "warp": "deny",
        "tools": "deny",
        "about": "deny",
        "spawn": "deny",
        "admin": "deny",
        "config": "deny",
        "((?!title|tellraw|give).)*": "deny"
      },
      "command_feedback": false,
      "name_decoration": {
        "prefix": {
          "text": "[EVENT] ",
          "color": "#CF27F5"
        },
        "style": "#CF27F5"
      },
      "join_access": {
        "allows_joining": false,
        "not_whitelisted_message": {
          "text": "The Event has not started yet. Please wait until it begins."
        },
        "join_limit": {
          "limit": 40,
          "message": {
            "text": "Some text about mysty event being full"
          }
        },
        "enforce": {
          "text": "Thanks you for playing!"
        }
      }
    }
  },
  "donator": {
    "includes": ["whitelisted"],
    "overrides": {}
  },
  "whitelisted": {
    "overrides": {
      "join_access": {
        "allows_joining": true
      }
    }
  }
}
