{
  "organiser": {
    "includes": ["administration"],
    "overrides": {
      "name_decoration": {
        "style": "#2ecc71"
      },
      "waypoint_icon": {
        "style": "lt:turtle",
        "color": [0.18, 0.8, 0.443]
      }
    }
  },
  "alt_account": {
    "includes": ["administration"],
    "overrides": {
      "name_decoration": {
        "prefix": {
          "text": "[ALT] ",
          "color": "red"
        },
        "style": "#31a2ac"
      }
    }
  },
  "administration": {
    "includes": ["whitelisted"],
    "overrides": {
      "op_level": 4,
      "commands": {
        ".*": "allow"
      }
    }
  },
  "live": {
    "includes": ["host"],
    "overrides": {
      "name_decoration": {
        "prefix": {
          "text": "▶ ",
          "color": "red"
        },
        "style": "#e91e63"
      },
      "host": true,
      "waypoint_icon": {
        "style": "lt:live",
        "color": [0.9137, 0.1176, 0.3882]
      }
    }
  },
  "host": {
    "includes": ["whitelisted"],
    "overrides": {
      "name_decoration": {
        "style": "#e91e63"
      },
      "commands": {
        "fly": "allow",
        "gamemode": "allow"
      },
      "waypoint_icon": {
        "style": "lt:host",
        "color": [0.914, 0.118, 0.388]
      }
    }
  },
  "mojangsta": {
    "includes": ["pro_builder"],
    "overrides": {
      "name_decoration": {
        "style": "#d84283"
      },
      "waypoint_icon": {
        "style": "lt:mojang",
        "color": [0.847, 0.2588, 0.5137]
      }
    }
  },
  "modder": {
    "includes": ["pro_builder", "game_controller"],
    "overrides": {
      "name_decoration": {
        "style": "#DEB22F"
      }
    }
  },
  "pro_builder": {
    "includes": ["builder"],
    "overrides": {
      "commands": {
        "clear": "allow",
        "effect": "allow",
        "map join .*": "allow",
        "map leave .*": "allow"
      }
    }
  },
  "builder": {
    "includes": ["trusted"],
    "overrides": {
      "name_decoration": {
        "style": "#a95cdd"
      }
    }
  },
  "moderator": {
    "includes": ["privileged"],
    "overrides": {
      "name_decoration": {
        "style": "#3498db"
      }
    }
  },
  "worldedit": {
    "overrides": {
      "op_level": 2,
      "worldedit_allowed": true,
      "commands": {
        "/.*": "allow",
        "mask .*": "allow",
        "/regen .*": "deny"
      }
    }
  },
  "game_controller": {
    "overrides": {
      "commands": {
        "game": "allow"
      }
    }
  },
  "trusted": {
    "includes": ["privileged"],
    "overrides": {
      "op_level": 2,
      "commands": {
        "fly": "allow",
        "give": "allow",
        "gamemode .*": "allow",
        "tp": "allow"
      }
    }
  },
  "privileged": {
    "includes": ["whitelisted"],
    "overrides": {
      "commands": {
        "kick": "allow",
        "ban": "allow",
        "ban-ip": "allow",
        "pardon": "allow",
        "pardon-ip": "allow",
        "banlist": "allow",
        "unban": "allow"
      }
    }
  },
  "dinners": {},
  "river_race_red": {},
  "river_race_blue": {},
  "commander": {
    "overrides": {
      "command_feedback": true
    }
  },
  "donator": {},
  "whitelisted": {
    "overrides": {
      "join_access": {
        "allows_joining": true
      }
    }
  },
  "everyone": {
    "overrides": {
      "commands": {
        "help": "allow",
        "game join": "allow",
        "game spectate": "allow",
        "game play": "allow",
        "game leave": "allow",
        "game register": "allow",
        "me": "allow",
        "w": "allow",
        "tell": "allow",
        "msg": "allow",
        "chat": "allow",
        "shout": "allow",
        "admin": "deny",
        "config": "deny",
        "((?!title|tellraw|give).)*": "deny",
        "spawnitems": "allow",
        "tpa": "allow",
        "tpaccept": "allow",
        "warp": "allow",
        "tools": "allow",
        "spawn": "allow"
      },
      "command_feedback": false,
      "join_access": {
        "allows_joining": false,
        "not_whitelisted_message": {
          "translate": "lt.whitelist.not_whitelisted"
        }
      }
    }
  }
}
