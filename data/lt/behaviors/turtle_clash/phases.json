[
  {
    "type": "ltminigames:progression",
    "named_points": {
      "start": 0,
      "release_players": 10,
      "anti_gravity_start": 150,
      "anti_gravity_warring": 240,
      "anti_gravity_end": 250,
      "end": 300,
      "close": 310
    }
  },
  {
    "type": "ltminigames:scheduled_actions",
    "target": "all",
    "actions": {
      "start": [
        {
          "type": "ltminigames:set_blocks",
          "region": ["red_wall", "blue_wall", "green_wall", "yellow_wall"],
          "replace": {
            "blocks": "air"
          },
          "set": "barrier"
        },
        {
          "type": "ltminigames:set_blocks",
          "region": ["red_wall", "blue_wall", "green_wall", "yellow_wall"],
          "replace": {
            "blocks": "water"
          },
          "set": "ltextras:water_barrier"
        }
      ],
      "release_players": [
        {
          "type": "ltminigames:run_commands",
          "player": ["tag @s add game.turtle_clash2"]
        },
        {
          "type": "ltminigames:set_blocks",
          "region": ["red_wall", "blue_wall", "green_wall", "yellow_wall"],
          "replace": {
            "blocks": "minecraft:barrier"
          },
          "set": "air"
        },
        {
          "type": "ltminigames:set_blocks",
          "region": ["red_wall", "blue_wall", "green_wall", "yellow_wall"],
          "replace": {
            "blocks": "ltextras:water_barrier"
          },
          "set": "water"
        },
        {
          "type": "ltminigames:show_title",
          "title": {
            "translate": "CLASH!!!",
            "color": "gold"
          },
          "fade_in": 5,
          "stay": 20,
          "fade_out": 5
        }
      ],
      "anti_gravity_start": [
        {
          "type": "ltminigames:run_commands",
          "player": [
            "execute on vehicle run data modify entity @s[type=tropicraft:turtle] LongsForTheSky set value True"
          ]
        },
        {
          "type": "ltminigames:play_sound",
          "sound": "ltminigames:correct"
        },
        {
          "type": "ltminigames:show_title",
          "title": {
            "translate": "Anti Gravity Mode",
            "color": "gold"
          },
          "subtitle": {
            "translate": "Take to The Skies!!",
            "color": "gray"
          },
          "fade_in": 5,
          "stay": 20,
          "fade_out": 5
        }
      ],
      "anti_gravity_warring": [
        {
          "type": "ltminigames:show_title",
          "title": {
            "translate": "Anti Gravity Mode Ending",
            "color": "gold"
          },
          "subtitle": {
            "translate": "Take to The Water!!",
            "color": "gray"
          },
          "fade_in": 5,
          "stay": 20,
          "fade_out": 5
        }
      ],
      "anti_gravity_end": [
        {
          "type": "ltminigames:run_commands",
          "player": [
            "execute on vehicle run data modify entity @s[type=tropicraft:turtle] LongsForTheSky set value False"
          ]
        },
        {
          "type": "ltminigames:show_title",
          "title": {
            "translate": "Game Over",
            "color": "gold"
          },
          "fade_in": 5,
          "stay": 20,
          "fade_out": 5
        }
      ],
      "end": [
        {
          "type": "ltminigames:play_sound",
          "sound": "minecraft:block.end_portal.spawn",
          "pitch": 0.2
        },
        "ltminigames:end_game"
      ],
      "close": "ltminigames:close_game"
    }
  },
  {
    "type": "ltminigames:phase_progress_bar",
    "entries": [
      {
        "period": {
          "start": 0.0,
          "end": "release_players"
        },
        "text": {
          "text": "Get Ready"
        },
        "color": "yellow",
        "reversed": true,
        "include_time": true
      },
      {
        "period": {
          "start": "release_players",
          "end": "anti_gravity_start"
        },
        "text": {
          "text": "Anti Grav Starts"
        },
        "color": "yellow",
        "reversed": true,
        "include_time": true
      },
      {
        "period": {
          "start": "anti_gravity_start",
          "end": "anti_gravity_end"
        },
        "text": {
          "text": "Anti Grav End"
        },
        "color": "yellow",
        "reversed": true,
        "include_time": true
      },
      {
        "period": {
          "start": "anti_gravity_end",
          "end": "end"
        },
        "text": {
          "text": "Time Left"
        },
        "color": "yellow",
        "reversed": true,
        "include_time": true
      }
    ]
  }
]
