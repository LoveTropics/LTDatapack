[
  {
    "type": "ltminigames:progression",
    "named_points": {
      "start": 0,
      "release_players": 3,
      "anti_gravity_start": 100,
      "anti_gravity_end": 150,
      "end": 300,
      "close": 315
    }
  },
  {
    "type": "ltminigames:scheduled_actions",
    "target": "all",
    "actions": {
      "release_players": [
        {
          "type": "ltminigames:run_commands",
          "player": [
            "tag @s add game.turtle_clash2"
          ]
        },
        {
          "type": "ltminigames:set_blocks",
          "region": [
            "red_wall",
            "blue_wall",
            "green_wall",
            "yellow_wall"
          ],
          "replace": {
            "blocks": "ltextras:edgeless_black_stained_glass"
          },
          "set": "air"
        },
        {
          "type": "ltminigames:send_message",
          "message": {
            "text": "Walls Open",
            "color": "gold"
          }
        }
      ],
      "anti_gravity_start": [
        {
          "type": "ltminigames:run_commands",
          "player": [
            "execute on vehicle run data modify entity @s[type=tropicraft:turtle] LongsForTheSky set value True"
          ]
        },
        {
          "type": "ltminigames:send_message",
          "message": {
            "translate": "Anti Grav Started",
            "color": "gold",
            "italic": true
          }
        }
      ],
      "anti_gravity_end": [
        {
          "type": "ltminigames:run_commands",
          "player": [
            "execute on vehicle run data modify entity @s[type=tropicraft:turtle] LongsForTheSky set value False"
          ]
        },
        {
          "type": "ltminigames:send_message",
          "message": {
            "translate": "Anti Grav Ended",
            "color": "gold",
            "italic": true
          }
        }
      ],
      "end": [
        {
          "type": "ltminigames:play_sound",
          "sound": "minecraft:block.end_portal.spawn",
          "pitch": 0.2
        },
        "ltminigames:end_game"
      ],
      "close": "ltminigames:close_game"
    }
  },
  {
    "type": "ltminigames:phase_progress_bar",
    "entries": [
      {
        "period": {
          "start": 0.0,
          "end": "release_players"
        },
        "text": {
          "text": "Get Ready"
        },
        "color": "yellow",
        "reversed": true,
        "include_time": true
      },
      {
        "period": {
          "start": "release_players",
          "end": "anti_gravity_start"
        },
        "text": {
          "text": "Anti Grav Starts"
        },
        "color": "yellow",
        "reversed": true,
        "include_time": true
      },
      {
        "period": {
          "start": "anti_gravity_start",
          "end": "anti_gravity_end"
        },
        "text": {
          "text": "Anti Grav End"
        },
        "color": "yellow",
        "reversed": true,
        "include_time": true
      },
      {
        "period": {
          "start": "anti_gravity_end",
          "end": "end"
        },
        "text": {
          "text": "Time Left"
        },
        "color": "yellow",
        "reversed": true,
        "include_time": true
      }
    ]
  }
]
