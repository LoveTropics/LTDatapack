[
  {
    "type": "ltminigames:river_race/zone",
    "id": "$id",
    "region": "$region",
    "ordinal_name": "$ordinal_name",
    "display_name": "$display_name",
    "color": "$color"
  },
  {
    "type": "ltminigames:phase_triggers/start",
    "actions": {
      "type": "ltminigames:add_colliders",
      "regions": "$colliders"
    }
  },
  {
    "type": "lt:river_race/microgames_countdown",
    "channel": {
      "$": {"prefix": "finish_", "path": "$id"}
    },
    "before_games_action": [
      {
        "type": "ltminigames:unlock_zone",
        "zone": "$next_id"
      },
      {
        "type": "ltminigames:remove_colliders",
        "regions": "$colliders"
      }
    ],
    "microgames": "$microgames"
  }
]
