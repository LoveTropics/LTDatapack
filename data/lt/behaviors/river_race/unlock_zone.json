[
  {
    "type": "ltminigames:progression",
    "channel": "$channel",
    "named_points": {
      "start": 0.05,
      "end": 45
    },
    "start": false
  },
  {
    "type": "ltminigames:countdown_effects",
    "target": "end",
    "sound": "ui.button.click",
    "pitch": {
      "start": 0.2,
      "end": 0.2
    },
    "seconds": 5,
    "show_title": true,
    "channel": "$channel"
  },
  {
    "type": "ltminigames:scheduled_actions",
    "target": "all",
    "channel": "$channel",
    "actions": {
      "end": [
        {
          "type": "ltminigames:play_sound",
          "sound": "minecraft:entity.arrow.hit_player",
          "pitch": 1.5
        },
        {
          "type": "ltminigames:unlock_zone",
          "zone": "$zone"
        },
        {
          "type": "ltminigames:remove_colliders",
          "regions": "$colliders"
        },
        "lt:river_race/start_microgames"
      ]
    }
  },
  {
    "type": "ltminigames:phase_progress_bar",
    "channel": "$channel",
    "entries": [
      {
        "period": ["start", "end"],
        "template": {
          "translate": "ltminigames.minigame.river_race.trivia.games_start_in",
          "color": "green"
        },
        "color": "green",
        "reversed": true
      }
    ]
  }
]
