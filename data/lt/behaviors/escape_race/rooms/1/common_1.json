[
  "ltminigames:disable_hunger",
  "ltminigames:disable_throwing_items",
  "lt:common/spectator",
  "ltminigames:teams",
  {
    "type": "ltminigames:position_players",
    "participants": "team_spawn",
    "spectators": "team_spawn"
  },
  {
    "type": "ltminigames:set_game_rules",
    "rules": {
      "doDaylightCycle": "false",
      "doWeatherCycle": "false",
      "doMobSpawning": "false",
      "announceAdvancements": "false",
      "fallDamage": "false",
      "doTileDrops": "false",
      "doFireTick": "false",
      "naturalRegeneration": "false",
      "mobGriefing": "false",
      "commandBlockOutput": "false"
    }
  },
  {
    "type": "ltminigames:distribute_loot",
    "region": "pots",
    "block_entity_type": "minecraft:decorated_pot",
    "item": {
      "id": "minecraft:redstone",
      "count": 1,
      "components": {
        "minecraft:can_place_on": [{
          "blocks": "#lt:escape_race_1_floor"
        }]
      }
    },
    "count": 300
  },
  "ltminigames:immediate_respawn",
  {
    "type": "ltminigames:block_in_region",
    "region": "should_end",
    "run_once": true,
    "predicate": {
      "blocks": "minecraft:waxed_copper_bulb",
      "state": {
        "lit": "true"
      }
    },
    "target": "all_players",
    "actions": [
      "ltminigames:end_game",
      {
        "type": "ltminigames:send_message",
        "message": {
          "translate": "You have braved the dark and Turned on the Lights, well done!",
          "color": "gold",
          "italic": true
        }
      },
      {
        "type": "ltminigames:play_sound",
        "sound": "minecraft:block.end_portal.spawn",
        "volume": 0.5
      }
    ]
  },
  {
    "type": "ltminigames:game_end_effects",
    "stop_delay": 100
  },
  {
    "type": "ltminigames:on_spawn",
    "role": "participant",
    "actions": [
      {
        "type": "ltminigames:add_equipment",
        "clear": true,
        "items": [
          {
            "id": "minecraft:stone_pickaxe",
            "components": {
              "unbreakable": {},
              "ltextras:undroppable": {},
              "minecraft:can_break": {
                "blocks": "#lt:escape_race_1_breakable"
              }
            }
          }
        ]
      }
    ]
  },
  {
    "type": "ltminigames:phase_triggers/start",
    "actions": {
        "type": "ltminigames:spawn_entity_at_regions",
        "entity": {
          "type": "minecraft:warden",
          "tag": {
            "AvoidDarkness": true,
            "CustomName": "Lil' Terror",
            "CustomNameVisible": true,
            "PersistenceRequired": true
          }
        },
        "regions_to_spawn_at": ["warden"],
        "entity_count_per_region": 1,
        "at_heightmap": false
      }
  }
]
