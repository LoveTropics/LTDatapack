{
  "type": "ltminigames:periodic_actions",
  "interval": "$time",
  "in_period": {
    "start": "$start",
    "end": "$end"
  },
  "actions": [
    {
      "type": "ltminigames:run_commands",
      "global": [
        "execute atregion item_spawn run loot spawn ~ ~ ~ loot lt:escape_race/random_trash"
      ]
    }
  ]
}
