    "actions": {
      "1": {
        "type": "ltminigames:send_message",
        "message": [
          {"text": "Bill Shoebill: ", "bold": true, "color": "green"},
          {"text": "Hmmm I wonder if we mix the clog with the cocoa bean-\n ", "bold": false, "color": "white"}
        ]
      },
      "5": {
        "type": "ltminigames:send_message",
        "message": [
          {"text": "Bill Shoebill: ", "bold": true, "color": "green"},
          {
            "text": "Oh hello there! I haven't seen you around these parts before.... I'm Bill Shoebill, Head of Uniform at EscapeRace. Or is it Head of Shoes... Hmm, I should ask Terry.\n ",
            "bold": false,
            "color": "white"
          }
        ]
      },
      "17": {
        "type": "ltminigames:send_message",
        "message": [
          {"text": "Bill Shoebill: ", "bold": true, "color": "green"},
          {
            "text": "Oh sorry, I was talking to you wasn't I... Anyway, I wonder if you could help me, I've lost my favourite shoes somewhere around here...\n",
            "bold": false,
            "color": "white"
          }
        ]
      },
      "24": {
        "type": "ltminigames:send_message",
        "message": [
          {"text": "Bill Shoebill: ", "bold": true, "color": "green"},
          {
            "text": "I can't possibly find them since my department has become over-run with angry mobs.... I wonder where they came from, maybe I should ask Terry...\n",
            "bold": false,
            "color": "white"
          }
        ]
      },
      "32": {
        "type": "ltminigames:send_message",
        "message": [
          {"text": "Bill Shoebill: ", "bold": true, "color": "green"},
          {"text": "Anyway, find me my favourite shoes and I'll let you back out!\n", "bold": false, "color": "white"}
        ]
      },
