[
  "ltminigames:disable_hunger",
  "ltminigames:disable_throwing_items",
  "lt:common/spectator",
  {
    "type": "ltminigames:progression",
    "named_points": {
      "start": 2
    }
  },
  {
    "type": "ltminigames:position_players",
    "participants": "team_spawn",
    "spectators": "team_spawn"
  },
  {
    "type": "ltminigames:set_game_rules",
    "rules": {
      "doDaylightCycle": "false",
      "doWeatherCycle": "false",
      "doMobSpawning": "true",
      "announceAdvancements": "false",
      "fallDamage": "false",
      "doTileDrops": "false",
      "doFireTick": "false",
      "naturalRegeneration": "false",
      "mobGriefing": "false"
    }
  },
  {
    "type": "ltminigames:statistic_threshold",
