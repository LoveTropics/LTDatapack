                  "rarity": "epic",
                  "item_name": [
                    "Monumentally Massive Mace",
                    { "color": "gray", "italic": true, "text": " (For Shoes)" }
                  ],
                  "lore": [
                    { "color": "gray", "text": "Sometimes as a Cobbler," },
                    { "color": "gray", "text": "you need delicate precision." },
                    { "color": "dark_gray", "text": "This isn't for that." }
