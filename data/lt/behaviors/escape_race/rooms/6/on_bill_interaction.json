{
  "type": "ltminigames:on_entity_interaction",
  "item_used": {
    "items": "$item_id"
  },
  "target_predicate": {
    "minecraft:entity_type": "tropicraft:shoebill_stork"
  },
  "target_actions": [
    {
      "type": "ltminigames:add_equipment",
