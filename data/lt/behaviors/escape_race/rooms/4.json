[
  {
    "type": "ltminigames:set_game_rules",
    "rules": {
      "doDaylightCycle": "false",
      "doWeatherCycle": "false",
      "doMobSpawning": "false",
      "fallDamage": "false",
      "announceAdvancements": "false",
      "doImmediateRespawn": "true",
      "commandBlockOutput": "false"
    }
  },
  {
    "type": "lt:common/playing",
    "game_type": "adventure",
    "join_late_with_role": "spectator"
  },
  {
    "type": "ltminigames:position_players",
    "participants": "team_spawn",
    "spectators": "spec_spawn"
  },
  {
    "type": "ltminigames:progression",
    "named_points": {
      "start": 0,
      "phone_call": 120,
      "end": 11000
    }
  },
  {
    "type": "ltminigames:scheduled_actions",
    "target": "participants",
    "actions": {
      "start": {
        "type": "ltminigames:run_commands",
        "player": [
          "give @s minecraft:light_gray_stained_glass_pane[max_stack_size=1] 36",
          "item replace entity @s hotbar.0 with air"
        ]
      },
      "phone_call": [
        {
          "type": "ltminigames:run_commands",
          "player": [
            "playsound lt:games.escape_race.terry_phone_call_one voice"
          ]
        },
        {
          "type": "ltminigames:send_message",
          "message": {
            "text": "AHHHH TERY PHONE CALL",
            "color": "gold"
          }
        }
      ]
    }
  },
  {
    "type": "ltminigames:terry_trash",
    "loot_table": "lt:escape_race/random_trash",
    "item_spawn_region": "item_spawn",
    "spawn_time": 80,
    "trash_data": {
      "can": {
        "required_amount": 10,
        "process_region": "trash_type_1_process"
      },
      "plastic_bottle": {
        "required_amount": 10,
        "process_region": "trash_type_2_process"
      },
      "chip_bag": {
        "required_amount": 10,
        "process_region": "trash_type_3_process"
      }
    }
  },
  {
    "type": "ltminigames:periodic_actions",
    "interval": 1,
    "actions": [
      {
        "type": "ltminigames:run_commands",
        "global": [
          "execute as @e[type=item,current_world=true] at @s if block ~ ~-1 ~ minecraft:magenta_glazed_terracotta[facing=west] run data modify entity @s Motion set value [0.1,0,0]",
          "execute as @e[type=item,current_world=true] at @s if block ~ ~-1 ~ minecraft:magenta_glazed_terracotta[facing=south] run data modify entity @s Motion set value [0,0,-0.1]"
        ]
      }
    ]
  }
]
