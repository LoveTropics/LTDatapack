[
  "lt:escape_race/rooms/common",
  {
    "type": "ltminigames:position_players",
    "participants": "spawn",
    "spectators": "spawn"
  },
  {
    "type": "ltminigames:progression",
    "named_points": {}
  },
  {
    "type": "ltminigames:prevent_block_interaction",
    "block_predicate": {
      "blocks": "#minecraft:trapdoors"
    }
  },
  {
    "type": "ltminigames:set_game_rules",
    "rules": {
      "doDaylightCycle": "false",
      "doWeatherCycle": "false",
      "doMobSpawning": "false",
      "announceAdvancements": "false",
      "fallDamage": "false",
      "doTileDrops": "true",
      "doFireTick": "false",
      "naturalRegeneration": "false",
      "mobGriefing": "false",
      "locatorBar": "false",
      "commandBlockOutput": "false"
    }
  },
  "lt:escape_race/rooms/5/barrels",
  "ltminigames:disable_hunger",
  "ltminigames:cancel_player_attacks",
  {
    "type": "ltminigames:on_spawn",
    "role": "participant",
    "actions": {
      "type": "ltminigames:cycle_action_by_entity",
      "actions_by_entity": [
        {
          "type": "ltminigames:add_equipment",
          "items": [
            {
              "id": "ltextras:orange_glasses",
              "count": 1,
              "components": {
                "ltextras:painting_overlay": [
                  {
                    "display_text": "20",
                    "painting": "lt:forklift_3"
                  },
                  {
                    "display_itemstack": {"id": "minecraft:bow", "count": 1},
                    "painting": "lt:terry_vacation_1"
                  }
                ],
                "minecraft:item_name": "Odd Orange Opticals"
              }
            }
          ]
        },
        {
          "type": "ltminigames:add_equipment",
          "items": [
            {
              "id": "ltextras:green_glasses",
              "count": 1,
              "components": {
                "ltextras:painting_overlay": [
                  {
                    "display_text": "-15",
                    "painting": "lt:forklift_5"
                  },
                  {
                    "display_itemstack": {"id": "minecraft:baked_potato", "count": 1},
                    "painting": "lt:terry_vacation_2"
                  }
                ],
                "minecraft:item_name": "Grand Green Glasses"
              }
            }
          ]
        },
        {
          "type": "ltminigames:add_equipment",
          "items": [
            {
              "id": "ltextras:blue_glasses",
              "count": 1,
              "components": {
                "ltextras:painting_overlay": [
                  {
                    "display_text": "3",
                    "painting": "lt:forklift_1"
                  },
                  {
                    "display_itemstack": {"id": "minecraft:ender_pearl", "count": 1},
                    "painting": "lt:terry_vacation_3"
                  }
                ],
                "minecraft:item_name": "Breathtaking Blue Bifocals"
              }
            }
          ]
        }
      ]
    }
  },
  {
    "type": "ltminigames:prevent_trampling_crops"
  },
  {
    "type": "ltminigames:increase_random_tick_rate_in_region",
    "regions": ["farmland"],
    "increased_tick_rate": 2
  },
  {
    "type": "ltminigames:prevent_crop_growth_in_region",
    "regions": ["no_grow"]
  },
  {
    "type": "ltminigames:scheduled_actions",
    "target": "all_players",
    "actions": {
      "0": [
        {
          "type": "ltminigames:show_title",
          "title": {
            "text": "◌̗",
            "font": "lt:ui",
            "color": "black"
          },
          "fade_in": 0,
          "stay": 2,
          "fade_out": 2
        },
        {
          "type": "ltminigames:simple_dialog",
          "target": "all_players",
          "speakers": {
            "gary": {"name": {"text": "Gary Gibnut", "color": "green"}},
            "izzy": {"name": {"text": "Izzy Illusioner", "color": "red"}}
          },
          "entries": {
            "2": {"speaker": "gary", "line": "HELLOOOOOO?!", "sound": "ltminigames:escape_race.room_5.sound_1"},
            "3": {"speaker": "gary", "line": "Is anybody there?!", "sound": "ltminigames:escape_race.room_5.sound_2"},
            "5": {"speaker": "gary", "line": "I'VE BEEN TRAPPED!", "sound": "ltminigames:escape_race.room_5.sound_3"},
            "6": {
              "speaker": "izzy",
              "line": "Hey, shut it you. Nobody's coming.... Oh... except... you.. People! The only way they're going to get you out of here is if they break this wall down!",
              "sound": "ltminigames:escape_race.room_5.izzy.sound_1"
            },
            "13": {
              "speaker": "gary",
              "line": "Izzy might look tough, but it's all...an illusion! She trapped me behind a few puzzles!! Get the code for the forklift vault and smash me out!",
              "sound": "ltminigames:escape_race.room_5.sound_5"
            }
          }
        }
      ],
      "15": {
        "type": "ltminigames:set_blocks",
        "region": ["paracord_hatch"],
        "set": "air",
        "notify_neighbors": true
      },
      "20": {
        "type": "ltminigames:set_extending_blocks",
        "region": ["paracord"],
        "set": "ltextras:paracord",
        "direction": "down",
        "duration": 50,
        "notify_neighbors": true
      }
    }
  },
  {
    "type": "ltminigames:item_frame_code",
    "item_frames": [
      {
        "item_frame_region": "code_frame_1",
        "light_region": "code_light_1",
        "item_predicate": {
          "items": ["minecraft:iron_ingot"]
        }
      },
      {
        "item_frame_region": "code_frame_2",
        "light_region": "code_light_2",
        "item_predicate": {
          "items": ["ltextras:battery"]
        }
      },
      {
        "item_frame_region": "code_frame_3",
        "light_region": "code_light_3",
        "item_predicate": {
          "items": ["ltextras:steering_wheel"]
        }
      }
    ],
    "button_region": "code_button",
    "lockout_ticks": 600,
    "lockout_cleared": [
      {
        "actions": {
          "type": "ltminigames:send_message",
          "message": [
            {"text": "Code lockout cleared!", "bold": true, "color": "green"}
          ]
        },
        "target": "all_players",
        "type": "ltminigames:apply_to"
      }
    ],
    "incorrect_code": [
      {
        "type": "ltminigames:show_title",
        "title": {
          "text": "Incorrect Code!",
          "color": "red"
        },
        "subtitle": {
          "text": "Code submission now locked out for 30 seconds...",
          "color": "white"
        },
        "stay": 40
      },
      {
        "actions": {
          "type": "ltminigames:send_message",
          "message": [
            {"text": "Incorrect Code Attempted! ", "bold": true, "color": "red"},
            {"text": "Code submission now locked out for 30 seconds...", "bold": false, "color": "white"}
          ]
        },
        "target": "all_players",
        "type": "ltminigames:apply_to"
      }
    ],
    "correct_code": [
      {
        "type": "ltminigames:show_title",
        "title": {
          "text": "Correct Code!",
          "color": "green"
        },
        "stay": 40
      },
      {
        "type": "ltminigames:nicely_break_region_of_blocks",
        "region": "forklift_vault_door"
      },
      {
        "actions":  {
          "type": "ltminigames:simple_dialog",
          "speakers": {
            "gary": {"name": {"text": "Gary Gibnut", "color": "green"}},
            "izzy": {"name": {"text": "Izzy Illusioner", "color": "red"}}
          },
          "entries": {
            "0": {"speaker": "gary", "line": "Great! You've got the forklift, now drive it straight at me!?!", "sound": "ltminigames:escape_race.room_5.sound_6"},
            "4": {"speaker": "izzy", "line": "That promotion was mine and you stole it from me! After everything we've been through... I'll never be head of forklifts now.", "sound": "ltminigames:escape_race.room_5.izzy.sound_2"}
          }
        },
        "target": "all_players",
        "type": "ltminigames:apply_to"
      }
    ]
  },
  {
    "type": "ltminigames:block_in_region",
    "region": "farm_land",
    "run_once": true,
    "predicate": {
      "blocks": ["#lt:escape_race_5_crops"]
    },
    "target": "all_players",
    "actions": [
      {
        "type": "ltminigames:increment_statistic",
        "statistic": "vacation_days",
        "amount": 1,
        "scope": "team"
      }
    ]
  },
  {
    "type": "ltminigames:block_in_region",
    "region": "redstone_lamp",
    "run_once": true,
    "predicate": {
      "blocks": "minecraft:waxed_copper_bulb",
      "state": {
        "lit": "true"
      }
    },
    "target": "all_players",
    "actions": [
      {
        "type": "ltminigames:increment_statistic",
        "statistic": "vacation_days",
        "amount": 1,
        "scope": "team"
      }
    ]
  },
  {
    "type": "ltminigames:events/player/tick",
    "predicate": {
      "equipment": {
        "head": {
          "items": ["ltextras:orange_glasses", "ltextras:blue_glasses", "ltextras:green_glasses"]
        }
      }
    },
    "actions": {
      "type": "ltminigames:increment_statistic",
      "statistic": "vacation_days",
      "amount": 1,
      "scope": "team"
    },
    "max_runs": 1
  },
  {
    "type": "ltminigames:statistic_threshold",
    "statistic": "code_items",
    "threshold": 1,
    "actions": [
      {
        "type": "ltminigames:increment_statistic",
        "statistic": "vacation_days",
        "amount": 2,
        "scope": "team"
      }
    ]
  },
  {
    "type": "ltminigames:item_put_in_item_frame",
    "tags": ["code_1", "code_2", "code_3"],
    "item_predicate": {
      "items": ["minecraft:iron_ingot", "ltextras:battery", "ltextras:steering_wheel"]
    },
    "matches": [
      {
        "type": "ltminigames:increment_statistic",
        "statistic": "code_items",
        "amount": 1,
        "scope": "team"
      }
    ]
  },
  {
    "type": "ltminigames:while_in_region",
    "run_once": "once",
    "regions": {
      "end_room": [
        {
          "type": "ltminigames:apply_to",
          "target": ["participants"],
          "actions": [
            {
              "type": "ltminigames:fade_to_black"
            }
          ]
        },
        {
          "type": "ltminigames:increment_statistic",
          "statistic": "vacation_days",
          "amount": 1,
          "scope": "team"
        },
        {
          "type": "ltminigames:close_game"
        }
      ]
    },
    "interval": 5
  },
  {
    "type": "ltminigames:phase_triggers/start",
    "actions": [
      {
        "type": "ltminigames:spawn_entity_at_regions",
        "entity": {
          "type": "tropicraft:gibnut",
          "tag": {
            "Invulnerable": true,
            "NoAI": true,
            "CustomName": "Gary Gibnut",
            "CustomNameVisible": true
          }
        },
        "regions_to_spawn_at": ["gary"],
        "entity_count_per_region": 1,
        "at_heightmap": false,
        "face_region": "spawn"
      },
      {
        "type": "ltminigames:spawn_entity_at_regions",
        "entity": {
          "type": "minecraft:illusioner",
          "tag": {
            "Invulnerable": true,
            "NoAI": true,
            "CustomName": "Izzy Illusioner",
            "CustomNameVisible": true
          }
        },
        "regions_to_spawn_at": ["izzy"],
        "entity_count_per_region": 1,
        "at_heightmap": false,
        "face_region": "spawn"
      }
    ]
  }
]
