[
  "ltminigames:teams",
  {
    "type": "ltminigames:position_players",
    "participants": "spawn",
    "spectators": "spawn"
  },
  {
    "type": "ltminigames:progression",
    "named_points": {}
  },
  {
    "type": "ltminigames:prevent_block_interaction",
    "block_predicate": {
      "blocks": "#minecraft:trapdoors"
    }
  },
  "ltminigames:immediate_respawn",
  "ltminigames:disable_hunger",
  {
    "type": "ltminigames:prevent_trampling_crops"
  },
  {
    "type": "ltminigames:increase_random_tick_rate_in_region",
    "regions": ["farmland"],
    "increased_tick_rate": 2
  },
  {
    "type": "ltminigames:prevent_crop_growth_in_region",
    "regions": ["no_grow"]
  },
  {
    "type": "ltminigames:scheduled_actions",
    "target": "all_players",
    "actions": {
      "0": {
        "type": "ltminigames:show_title",
        "title": {
          "text": "◌̗",
          "font": "lt:ui",
          "color": "black"
        },
        "fade_in": 0,
        "stay": 2,
        "fade_out": 2
      },
      "2": {
        "type": "ltminigames:send_message",
        "message": [
          { "text": "Gary Gibnut: ", "bold": true, "color": "green" },
          { "text": "HELLOOOOOO?!\n ", "color": "white" }
        ]
      },
      "3": {
        "type": "ltminigames:send_message",
        "message": [
          { "text": "Gary Gibnut: ", "bold": true, "color": "green" },
          { "text": "Is anybody there?!\n ", "color": "white" }
        ]
      },
      "5": {
        "type": "ltminigames:send_message",
        "message": [
          { "text": "Gary Gibnut: ", "bold": true, "color": "green" },
          { "text": "I'VE BEEN TRAPPED!\n", "color": "white" }
        ]
      },
      "6": {
        "type": "ltminigames:send_message",
        "message": [
          { "text": "Izzy Illusioner: ", "bold": true, "color": "red" },
          { "text": "Shut it you. Nobody's coming.\n ", "color": "white" }
        ]
      },
      "9": {
        "type": "ltminigames:send_message",
        "message": [
          { "text": "Gary Gibnut: ", "bold": true, "color": "green" },
          {
            "text": "Wait I can hear someone! Help me! Please! You've got to break me out of here!\n",
            "color": "white"
          }
        ]
      },
      "12": {
        "type": "ltminigames:send_message",
        "message": [
          { "text": "Izzy Illusioner: ", "bold": true, "color": "red" },
          {
            "text": "Urgh. People.... The only way they're going to get you out of here is if they break this wall down! \n ",
            "color": "white"
          }
        ]
      },
      "13": {
        "type": "ltminigames:send_message",
        "message": [
          { "text": "Gary Gibnut: ", "bold": true, "color": "green" },
          {
            "text": "Izzy might look tough, but it's all...an illusion! She trapped me behind a few puzzles!! Get the code for the forklift vault and smash me out!\n ",
            "color": "white"
          }
        ]
      },
      "15": {
        "type": "ltminigames:set_blocks",
        "region": ["paracord_hatch"],
        "set": "air",
        "notify_neighbors": true
      },
      "20": {
        "type": "ltminigames:set_extending_blocks",
        "region": ["paracord"],
        "set": "ltextras:paracord",
        "direction": "down",
        "duration": 50,
        "notify_neighbors": true
      }
    }
  },
  {
    "type": "ltminigames:item_frame_code",
    "item_frames": [
      {
        "item_frame_region": "code_frame_1",
        "light_region": "code_light_1",
        "item_predicate": {
          "items": ["minecraft:iron_ingot"]
        }
      },
      {
        "item_frame_region": "code_frame_2",
        "light_region": "code_light_2",
        "item_predicate": {
          "items": ["minecraft:nether_star"]
        }
      },
      {
        "item_frame_region": "code_frame_3",
        "light_region": "code_light_3",
        "item_predicate": {
          "items": ["minecraft:clock"]
        }
      }
    ],
    "button_region": "code_button",
    "lockout_ticks": 600,
    "lockout_cleared": [
      {
        "actions": {
          "type": "ltminigames:send_message",
          "message": [
            {"text": "Code lockout cleared!", "bold": true, "color": "green"}
          ]
        },
        "target": "all_players",
        "type": "ltminigames:apply_to"
      }
    ],
    "incorrect_code": [
      {
        "type": "ltminigames:show_title",
        "title": {
          "text": "Incorrect Code!",
          "color": "red"
        },
        "subtitle": {
          "text": "Code submission now locked out for 30 seconds...",
          "color": "white"
        },
        "stay": 40
      },
      {
        "actions": {
          "type": "ltminigames:send_message",
          "message": [
            {"text": "Incorrect Code Attempted! ", "bold": true, "color": "red"},
            {"text": "Code submission now locked out for 30 seconds...", "bold": false, "color": "white"}
          ]
        },
        "target": "all_players",
        "type": "ltminigames:apply_to"
      }
    ],
    "correct_code": [
      {
        "type": "ltminigames:show_title",
        "title": {
          "text": "Correct Code!",
          "color": "green"
        },
        "stay": 40
      },
      {
        "type": "ltminigames:nicely_break_region_of_blocks",
        "region": "forklift_vault_door"
      },
      {
        "actions": {
          "type": "ltminigames:send_message",
          "message": [
            {"text": "GG!", "bold": true, "color": "green"}
          ]
        },
        "target": "all_players",
        "type": "ltminigames:apply_to"
      }
    ]
  },
  {
    "type": "ltminigames:while_in_region",
    "regions": {
      "end_room": [
        {
          "type": "ltminigames:close_game"
        }
      ]
    },
    "interval": 5
  },
  {
    "type": "ltminigames:phase_triggers/start",
    "actions": [
      {
        "type": "ltminigames:spawn_entity_at_regions",
        "entity": {
          "type": "tropicraft:gibnut",
          "tag": {
            "Invulnerable": true,
            "NoAI": true,
            "CustomName": "Gary Gibnut",
            "CustomNameVisible": true
          }
        },
        "regions_to_spawn_at": ["gary"],
        "entity_count_per_region": 1,
        "at_heightmap": false,
        "face_region": "spawn"
      },
      {
        "type": "ltminigames:spawn_entity_at_regions",
        "entity": {
          "type": "minecraft:illusioner",
          "tag": {
            "Invulnerable": true,
            "NoAI": true,
            "CustomName": "Izzy Illusioner",
            "CustomNameVisible": true
          }
        },
        "regions_to_spawn_at": ["izzy"],
        "entity_count_per_region": 1,
        "at_heightmap": false,
        "face_region": "spawn"
      }
    ]
  }
]
