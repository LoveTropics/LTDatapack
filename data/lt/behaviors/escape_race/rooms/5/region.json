[
  {
    "type": "ltminigames:item_put_in_item_frame",
    "tags": ["$color"],
    "item_predicate": {
      "items": "$item"
    },
    "matches": [
      {
        "type": "ltminigames:increment_statistic",
        "statistic": "points",
        "amount": 1,
        "scope": "team"
      },
      {
        "type": "ltminigames:delayed",
        "delay": 1,
        "actions": [
          {
            "type": "ltminigames:run_commands",
            "player": ["data modify entity @e[type=minecraft:item_frame,limit=1,sort=nearest] Fixed set value true"]
          }
        ]
      },
      {
        "type": "ltminigames:play_sound",
        "sound": "ltminigames:correct"
      },
      {
        "type": "ltminigames:show_title",
        "title": {
          "translate": "Key Placed",
          "color": "gold"
        },
        "fade_in": 10,
        "stay": 60,
        "fade_out": 10
      }
    ]
  },
  {
    "type": "ltminigames:item_dropper",
    "loot": [
      {
        "id": "$item"
      }
    ],
    "region": "$color",
    "interval_ticks": 1,
    "beacon": false
  }
]
