{
  "type": "ltminigames:sequence",
  "sequence": [
    {
      "type": "ltminigames:apply_for_time",
      "mutex": "lt:disguise_package",
      "force_acquire_mutex": true,
      "apply": {
        "target": "participants",
        "actions": {
          "type": "ltminigames:run_commands",
          "entity": ["disguise skin as @p[role=live]", "disguise name as {\"selector\":\"@p[role=live]\"}"]
        }
      },
      "clear": {
        "target": "all_players",
        "actions": {
          "type": "ltminigames:run_commands",
          "entity": ["disguise skin clear", "disguise name clear"]
        }
      },
      "seconds": "$seconds"
    },
    {
      "type": "ltminigames:notify_package",
      "name": {"translate": "ltminigames.minigame.donation.everyone_host"},
      "message": {
        "translate": "ltminigames.minigame.donation.everyone_host.toast",
        "color": "light_purple"
      },
      "icon": {
        "item": {
          "id": "peekaboo:disguise",
          "count": 1,
          "components": {"peekaboo:disguise": {"entity": {"id": "dummyplayers:dummy_player"}}}
        }
      },
      "sentiment": "neutral",
      "sound": "ltminigames:sabotage_receive"
    }
  ]
}
