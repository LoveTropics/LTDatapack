{
  "type": "ltminigames:donation_package",
  "id": "$id",
  "package_type": "care_package",
  "target": "team",
  "donation_amount": "$amount",
  "apply_to_team": true,
  "receive_actions": [
    {
      "type": "ltminigames:give_donated_tropicoins",
      "scope": "team"
    },
    {
      "type": "ltminigames:show_title",
      "subtitle": {
        "translate": "ltminigames.minigame.donation.player_donation.title",
        "color": "red"
      },
      "stay": 60
    }
  ],
  "notification": {
    "icon": {
      "item": "ltextras:tropicoin"
    }
  }
}
