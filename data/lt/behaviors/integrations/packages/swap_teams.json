{
  "type": "ltminigames:donation_package",
  "id": "swap_teams_package",
  "package_type": "sabotage_package",
  "target": "all_players",
  "name": {
    "translate": "ltminigames.minigame.donation.swap"
  },
  "description": {
    "translate": "ltminigames.minigame.donation.swap.description"
  },
  "donation_amount": "$donation_amount",
  "receive_actions": [
    {
      "type": "ltminigames:countdown_action",
      "warning": {
        "translate": "ltminigames.minigame.donation.swap.warning",
        "color": "red"
      },
      "countdown": 5,
      "max_queue_size": 1,
      "actions": {
        "type": "ltminigames:swap_teams"
      }
    }
  ],
  "notification": {
    "message": {
      "translate": "ltminigames.minigame.donation.swap.toast",
      "color": "red"
    },
    "icon": {
      "effect": "minecraft:unluck"
    },
    "sound": "ltminigames:sabotage_receive"
  }
}
