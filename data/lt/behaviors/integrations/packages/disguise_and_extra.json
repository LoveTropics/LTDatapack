{
  "type": "ltminigames:donation_package",
  "id": "$id",
  "package_type": "care_package",
  "target": "all_players",
  "donation_amount": "$donation_amount",
  "receive_actions": [
    {
      "type": "ltminigames:apply_for_time",
      "mutex": "lt:disguise_package",
      "force_acquire_mutex": true,
      "apply": {
        "target": "participants",
        "actions": {
          "type": "ltminigames:set_disguise",
          "entity": "$entity",
          "changes_size": false,
          "apply_donor_name": "$apply_donor_name"
        }
      },
      "clear": {
        "target": "all_players",
        "actions": {
          "type": "ltminigames:clear_disguise",
          "entity": "$entity"
        }
      },
      "seconds": "$seconds"
    },
    "$action"
  ],
  "notification": {
    "message": {
      "translate": "$toast",
      "color": "light_purple"
    },
    "icon": {
      "item": {
        "id": "peekaboo:disguise",
        "count": 1,
        "components": {
          "peekaboo:disguise": {
            "entity": "$entity"
          }
        }
      }
    },
    "sentiment": "neutral"
  }
}