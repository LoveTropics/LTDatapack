{
  "type": "ltminigames:donation_package",
  "id": "player_donation",
  "package_type": "care_package",
  "category": "large",
  "player_select": "specific",
  "name": {"translate": "ltminigames.minigame.donation.player_donation"},
  "description": {"translate": "ltminigames.minigame.donation.player_donation.description"},
  "donation_amount": "$amount",
  "notification": {
    "message": {
      "translate": "ltminigames.minigame.donation.player_donation.toast",
      "color": "light_purple"
    },
    "icon": {"item": "ltextras:tropicoin"},
    "sentiment": "positive",
    "sound": "ltminigames:package_receive"
  },
  "receive_actions": [
    {
      "type": "ltminigames:give_items_amount_based",
      "item": "ltextras:tropicoin",
      "amount": "$amount"
    },
    {
      "type": "ltminigames:show_title",
      "subtitle": {
        "translate": "ltminigames.minigame.donation.player_donation.title",
        "color": "red"
      },
      "stay": 60
    }
  ]
}
