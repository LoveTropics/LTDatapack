{
  "type": "ltminigames:donation_package",
  "id": "everyone_host",
  "package_type": "sabotage_package",
  "target": "all_players",
  "donation_amount": "$donation_amount",
  "receive_actions": [
    {
      "type": "ltminigames:apply_for_time",
      "mutex": "lt:disguise_package",
      "force_acquire_mutex": true,
      "apply": {
        "target": "participants",
        "actions": {
          "type": "ltminigames:run_commands",
          "entity": [
            "disguise skin as @p[role\u003dlive]",
            "disguise name as {\"selector\":\"@p[role\u003dlive]\"}"
          ]
        }
      },
      "clear": {
        "target": "all_players",
        "actions": {
          "type": "ltminigames:run_commands",
          "entity": [
            "disguise skin clear",
            "disguise name clear"
          ]
        }
      },
      "seconds": "$seconds"
    },
    {
      "type": "ltminigames:notify_package",
      "icon": {
        "item": {
          "id": "peekaboo:disguise",
          "count": 1,
          "components": {
            "peekaboo:disguise": {
              "entity": {
                "id": "dummyplayers:dummy_player"
              }
            }
          }
        }
      },
      "sentiment": "neutral"
    }
  ]
}
