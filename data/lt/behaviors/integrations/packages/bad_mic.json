{
  "type": "ltminigames:donation_package",
  "id": "bad_mic",
  "package_type": "sabotage_package",
  "target": "all_players",
  "donation_amount": "$donation_amount",
  "receive_actions": [
    {
      "type": "ltminigames:apply_for_time",
      "mutex": "lt:microphone_quality",
      "apply": {
        "target": "participants",
        "actions": {
          "type": "ltgames_voice:modify_voice",
          "quality": 0.1
        }
      },
      "clear": {
        "target": "all_players",
        "actions": {
          "type": "ltgames_voice:modify_voice",
          "quality": 1.0
        }
      },
      "seconds": "$seconds"
    }
  ],
  "notification": {
    "icon": {
      "item": {
        "id": "minecraft:barrier"
      }
    }
  }
}
