[
  {
    "type": "ltminigames:progression",
    "named_points": {
      "go": 10
    }
  },
  "lt:turtle_race/donations",
  {
    "type": "lt:common/playing",
    "game_type": "adventure",
    "join_late_with_role": "spectator"
  },
  {
    "type": "ltminigames:force_load_region",
    "region": "force_load"
  },
  {
    "type": "ltminigames:position_players",
    "participants": "player_spawn",
    "spectators": "point_1"
  },
  {
    "type": "ltminigames:rider",
    "entity": {
      "type": "tropicraft:turtle",
      "tag": {
        "Invulnerable": true,
        "NoAI": true,
        "attributes": [
          {
            "base": 1.65,
            "id": "minecraft:movement_speed"
          }
        ],
        "NoBrakesOnThisTrain": true,
        "DeathLootTable": "minecraft:empty"
      }
    }
  },
  {
    "type": "ltminigames:countdown_effects",
    "target": "go",
    "sound": "minecraft:entity.arrow.hit_player",
    "seconds": 3,
    "show_title": true
  },
  {
    "type": "ltminigames:scheduled_actions",
    "target": "all_players",
    "actions": {
      "go": [
        {
          "type": "ltminigames:set_blocks",
          "region": "start_floor",
          "replace": {
            "blocks": "#lt:all_stained_glass"
          },
          "set": "air"
        },
        {
          "type": "ltminigames:play_sound",
          "sound": "entity.arrow.hit_player",
          "pitch": 1.5
        },
        {
          "type": "ltminigames:show_title",
          "title": {
            "translate": "ltminigames.minigame.turtle_race.go",
            "color": "green"
          },
          "stay": 40
        },
        {
          "type": "ltminigames:give_effect",
          "effects": [
            {
              "type": "minecraft:water_breathing",
              "seconds": 999999,
              "amplifier": 80,
              "particles": false,
              "show_icon": false
            }
          ]
        }
      ]
    }
  },
  {
    "type": "ltminigames:race_track",
    "path": {
      "start": 0,
      "end": "$track_point_count",
      "prefix": "point_"
    },
    "lap_count": "$lap_count",
    "winner_count": 3,
    "start_time": 200,
    "finish_region": "finish",
    "checkpoint_regions": {
      "checkpoint": [
        {
          "type": "ltminigames:play_sound",
          "sound": "entity.arrow.hit_player"
        },
        {
          "type": "ltminigames:show_title",
          "action_bar": {
            "translate": "ltminigames.minigame.turtle_race.speed_boost",
            "color": "green"
          }
        },
        {
          "type": "ltminigames:turtle_boost",
          "amount": 1.0,
          "duration": 40
        }
      ]
    }
  },
  {
    "type": "ltminigames:game_end_effects",
    "stop_delay": 400,
    "scheduled_messages": {
      "0": {
        "text": "%winner% completed the race in the shortest amount of time and won the game!",
        "color": "gray"
      }
    }
  },
  {
    "type": "ltminigames:events/game_over",
    "actions": {
      "type": "ltminigames:setup_podium",
      "winner_regions": ["winner_1", "winner_2", "winner_3"],
      "loser_region": "loser_spawn"
    }
  },
  "lt:common/game_over_title",
  "lt:common/spectator",
  "ltminigames:cancel_player_damage",
  {
    "type": "ltminigames:set_game_rules",
    "rules": {
      "doDaylightCycle": "false",
      "doWeatherCycle": "false",
      "doMobSpawning": "false",
      "announceAdvancements": "false",
      "doTileDrops": "false",
      "doEntityDrops": "false",
      "commandBlockOutput": "false",
      "locatorBar": "false"
    }
  },
  "lt:turtle_race/rewards"
]
