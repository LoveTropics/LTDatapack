[
  {
    "type": "lt:common/playing",
    "game_type": "survival",
    "join_late_with_role": "spectator",
    "rejoin": "restore",
    "statistics_key": "hardcore_havoc"
  },
  {"type":  "ltminigames:announcements"},
  {
    "type": "ltminigames:position_players",
    "teams": {
      "blue": ["blue"],
      "red": ["red"],
      "yellow": ["yellow"],
      "green": ["green"]
    },
    "split_by_team": true,
    "spectators": ["spectators"]
  },
  "ltminigames:sync_teams",
  {
    "type": "ltminigames:set_client_state",
    "state": {
      "type": "ltminigames:glow_team_members"
    }
  },
  {
    "type": "ltminigames:events/game_over",
    "actions": [
      {
        "type": "ltminigames:show_title",
        "title": {
          "translate": "ltminigames.minigame.game_over.title",
          "color": "gold"
        },
        "subtitle": {
          "translate": "ltminigames.minigame.game_over.subtitle",
          "color": "gray"
        },
        "fade_in": 10,
        "stay": 60,
        "fade_out": 10
      },
      {
        "type": "ltminigames:play_sound",
        "sound": "minecraft:ui.toast.challenge_complete"
      },
      {
        "type": "ltminigames:named_stages/skip_to",
        "stage": "post_game",
        "ignore_end_actions": true
      }
    ],
    "target": "all_players"
  },
  {
    "type": "ltminigames:set_client_state",
    "state": {
      "type": "ltminigames:remap_sprite",
      "remap": {
        "hud/heart/container": "hud/heart/container_hardcore",
        "hud/heart/container_blinking": "hud/heart/container_hardcore_blinking",
        "hud/heart/full": "hud/heart/hardcore_full",
        "hud/heart/full_blinking": "hud/heart/hardcore_full_blinking",
        "hud/heart/half": "hud/heart/hardcore_half",
        "hud/heart/half_blinking": "hud/heart/hardcore_half_blinking",
        "hud/heart/poisoned_full": "hud/heart/poisoned_hardcore_full",
        "hud/heart/poisoned_full_blinking": "hud/heart/poisoned_hardcore_full_blinking",
        "hud/heart/poisoned_half": "hud/heart/poisoned_hardcore_half",
        "hud/heart/poisoned_half_blinking": "hud/heart/poisoned_hardcore_half_blinking",
        "hud/heart/withered_full": "hud/heart/withered_hardcore_full",
        "hud/heart/withered_full_blinking": "hud/heart/withered_hardcore_full_blinking",
        "hud/heart/withered_half": "hud/heart/withered_hardcore_half",
        "hud/heart/withered_half_blinking": "hud/heart/withered_hardcore_half_blinking",
        "hud/heart/absorbing_full": "hud/heart/absorbing_hardcore_full",
        "hud/heart/absorbing_full_blinking": "hud/heart/absorbing_hardcore_full_blinking",
        "hud/heart/absorbing_half": "hud/heart/absorbing_hardcore_half",
