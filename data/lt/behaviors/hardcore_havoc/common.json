        "hud/heart/frozen_full": "hud/heart/frozen_hardcore_full",
        "hud/heart/frozen_full_blinking": "hud/heart/frozen_hardcore_full_blinking",
        "hud/heart/frozen_half": "hud/heart/frozen_hardcore_half",
        "hud/heart/frozen_half_blinking": "hud/heart/frozen_hardcore_half_blinking"
      }
