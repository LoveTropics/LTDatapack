[
  {
    "type": "ltminigames:position_players",
    "participants": "player_spawn",
    "spectators": "spectator_spawn"
  },
  "lt:common/spectator",
  "lt:mysty/shared",
  "lt:mysty/integrations/spleef",
  {
    "type": "ltminigames:projectile_break_block",
    "block": {
      "blocks": ["minecraft:snow_block"]
    },
    "projectile": {
      "type": "minecraft:snowball"
    }
  },
  {
    "type": "ltminigames:set_game_rules",
    "rules": {
      "doDaylightCycle": "false",
      "doWeatherCycle": "false",
      "doMobSpawning": "false",
      "fallDamage": "false",
      "doTileDrops": "false",
      "announceAdvancements": "false",
      "doImmediateRespawn": "true"
    }
  },
  {
    "type": "ltminigames:progression",
    "named_points": {
      "game": 15,
      "finish": 30000
    }
  },
  {
    "type": "ltminigames:block_break",
    "actions": [
      {
        "type": "ltminigames:give_loot",
        "loot_table": "lt:mysty/snowball"
      }
    ]
  },
  {
    "type": "ltminigames:scheduled_actions",
    "target": "participants",
    "actions": {
      "game": [
        {
          "type": "ltminigames:add_equipment",
          "items": [
            {
              "id": "minecraft:netherite_shovel",
              "components": {
                "unbreakable": {},
                "ltextras:undroppable": {},
                "enchantment_glint_override": true,
                "tool": {
                  "rules": [
                    {
                      "blocks": ["minecraft:snow_block"],
                      "speed": 5000
                    }
                  ]
                },
                "can_break": {
                  "blocks": ["minecraft:snow_block"]
                }
              }
            }
          ]
        }
      ]
    }
  },
  {
    "type": "ltminigames:spleef",
    "forced_progression_seconds": "$forced_progression",
    "floors": "$floors",
    "floor_material": "minecraft:snow_block",
    "floor_breaking_material": "minecraft:blue_ice",
    "flavor_text": "mysty",
    "break_count": "$break_count",
    "break_interval": "$break_interval"
  },
  {
    "type": "ltminigames:cancel_player_damage",
    "knockback": false
  },
  {
    "type": "ltminigames:immediate_respawn",
    "role": "participant",
    "respawn_as": "spectator",
    "respawn_action": [
      {
        "type": "ltminigames:play_sound",
        "sound": "block.anvil.land",
        "source": "player",
        "volume": 0.75
      },
      {
        "type": "ltminigames:clear_effects"
      }
    ]
  },
  {
    "type": "ltminigames:set_client_state",
    "state": {
      "type": "ltminigames:disable_player_collision"
    }
  },
  "ltminigames:disable_crafting",
  {
    "type": "ltminigames:projectile_knockback",
    "projectile": {
      "type": "minecraft:snowball"
    },
    "target": {
      "type": "minecraft:player"
    },
    "strength": 0.4
  },
  "lt:mysty/spleef/coins"
]
