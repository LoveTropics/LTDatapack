[
  "lt:common/spectator",
  "ltminigames:disable_hunger",
  "ltminigames:disable_throwing_items",
  "lt:mysty/global",
  "lt:mysty/integrations/arena",
  "ltminigames:last_remaining_win_trigger",
  "ltminigames:place_by_death_order",
  {
    "type": "ltminigames:immediate_respawn",
    "role": "participant",
    "respawn_as": "spectator",
    "death_message": {
      "translate": "ltminigames.minigame.survive_the_tide.eliminated",
      "color": "gray"
    },
    "drop_inventory": false
  },
  {
    "type": "ltminigames:set_game_rules",
    "rules": {
      "minecraft:block_drops": false,
      "minecraft:command_blocks_work": false,
      "minecraft:locator_bar": false,
      "minecraft:spawn_mobs": false,
      "minecraft:immediate_respawn": true,
      "minecraft:advance_weather": false,
      "minecraft:fall_damage": false,
      "minecraft:advance_time": false,
      "minecraft:show_advancement_messages": false
    }
  },
  {
    "type": "ltminigames:position_players",
    "participants": "player_spawn",
    "spectators": "spectator_spawn"
  },
  {
    "type": "ltminigames:kill_in_void",
    "void_below_region": "void"
  },
  {
    "type": "ltminigames:permanent_item",
    "item": {
      "id": "tropicraft:exploding_coconut",
      "count": 1,
      "components": {
        "tropicraft:explosion_radius": 2,
        "ltextras:undroppable": {}
      }
    },
    "interval": 400
  },
  {
    "type": "ltminigames:events/game_over",
    "actions": [
      {
        "type": "ltminigames:show_title",
        "title": {
          "translate": "ltminigames.minigame.game_over.title",
          "color": "gold"
        },
        "subtitle": {
          "translate": "ltminigames.minigame.game_over.subtitle",
          "color": "gray"
        },
        "fade_in": 10,
        "stay": 60,
        "fade_out": 10
      },
      {
        "type": "ltminigames:delayed",
        "delay": 100,
        "actions": [
          "ltminigames:close_game"
        ]
      }
    ],
    "target": "all_players"
  },
  {
    "type": "ltminigames:scale_damage",
    "factor": 0.0,
    "source": {
      "direct_entity": {
        "minecraft:entity_type": "tropicraft:exploding_coconut"
      }
    }
  },
  {
    "type": "ltminigames:scale_explosion_knockback",
    "factor": 2.25,
    "exploder": {
      "minecraft:entity_type": "tropicraft:exploding_coconut"
    }
  },
  {
    "type": "ltminigames:on_spawn",
    "role": "participant",
    "actions": [
      {
        "type": "ltminigames:add_equipment",
        "clear": true,
        "items": [
          {
            "id": "minecraft:wooden_hoe",
            "components": {
              "unbreakable": {},
              "ltextras:undroppable": {},
              "enchantments": {
                "knockback": 3
              }
            }
          }
        ]
      }
    ]
  },
  "lt:mysty/coins_on_death"
