  },
  {
    "type": "ltminigames:scheduled_actions",
    "channel": "freeze",
    "target": "participants",
    "actions": {
      "unfreeze": {
        "type": "ltminigames:add_equipment",
        "items": [
          {
            "id": "tropicraft:exploding_coconut",
            "count": 3,
            "components": {
              "tropicraft:explosion_radius": 2,
              "ltextras:undroppable": {}
            }
          }
        ]
      }
    }
  },
  {
    "type": "ltminigames:only_tick_in_period",
    "channel": "freeze",
    "period": {
      "start": "unfreeze"
    },
    "behavior": {
      "type": "ltminigames:permanent_item",
      "item": {
        "id": "tropicraft:exploding_coconut",
        "count": 1,
        "components": {
          "tropicraft:explosion_radius": 2,
          "ltextras:undroppable": {}
        }
      },
      "max_count": 10,
      "interval": 600
    }
  },
  {
    "type": "ltminigames:events/game_over",
    "actions": [
      {
        "type": "ltminigames:show_title",
        "title": {
          "translate": "ltminigames.minigame.game_over.title",
          "color": "gold"
        },
        "subtitle": {
          "translate": "ltminigames.minigame.game_over.subtitle",
          "color": "gray"
        },
        "fade_in": 10,
        "stay": 60,
        "fade_out": 10
      },
      {
        "type": "ltminigames:delayed",
        "delay": 100,
        "actions": [
          "ltminigames:close_game"
        ]
      }
    ],
    "target": "all_players"
  },
  {
    "type": "ltminigames:on_spawn",
