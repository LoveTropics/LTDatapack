    "actions": [
      {
        "type": "ltminigames:add_equipment",
        "items": [
          {
            "id": "minecraft:stick",
            "components": {
              "unbreakable": {},
              "ltextras:undroppable": {},
              "enchantments": {
                "knockback": 3
              }
            }
          }
        ],
        "allow_duplicates": false
      }
    ]
