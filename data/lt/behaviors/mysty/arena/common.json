    "type": "ltminigames:immediate_respawn",
    "role": "participant",
    "respawn_as": "spectator",
    "death_message": [
      {
        "left_highlight": "#a08e0021",
        "right_highlight": "#60191829"
      },
      {
        "translate": "ltminigames.minigame.survive_the_tide.eliminated",
        "color": "gray"
      }
    ],
    "drop_inventory": false
  },
  {
