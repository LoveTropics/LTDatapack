      "minecraft:locator_bar": false,
      "minecraft:spawn_mobs": false,
      "minecraft:immediate_respawn": true,
      "minecraft:advance_weather": false,
      "minecraft:fall_damage": false,
      "minecraft:advance_time": false,
      "minecraft:show_advancement_messages": false,
      "tropicraft:unrestricted_exploding_coconuts": true
    }
  },
  {
    "type": "ltminigames:position_players",
    "participants": "player_spawn",
    "spectators": "spectator_spawn"
  },
  {
    "type": "ltminigames:kill_in_void",
