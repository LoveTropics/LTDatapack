{
  "type": "ltminigames:custom_command",
  "path": [
    "competition",
    "score"
  ],
  "permission_level": "overlord",
  "argument": "none",
  "actions": [
    {
      "type": "ltminigames:place_by_statistic",
      "statistic": "points",
      "order": "max"
    },
    {
      "type": "ltminigames:setup_podium",
      "winner_regions": [
        "winner_1",
        "winner_2",
        "winner_3"
      ],
      "loser_region": "spawn",
      "winner_actions": [
        [
          "lt:mysty/winner/first_place"
        ],
        [
          "lt:mysty/winner/second_place"
        ],
        [
          "lt:mysty/winner/third_place"
        ]
      ],
      "loser_actions": {
        "type": "ltminigames:add_equipment",
        "clear": true
      }
    },
    {
      "type": "ltminigames:apply_to",
      "target": "all_players",
      "actions": [
        {
          "type": "ltminigames:display_leaderboard",
          "statistic": "points",
          "order": "max",
          "length": 5,
          "header": {
            "translate": "ltminigames.minigame.mysty.results"
          }
        }
      ]
    },
    {
      "type": "ltminigames:delayed",
      "initial_delay": 0,
      "delay": {
        "type": "uniform",
        "min_inclusive": 1,
        "max_inclusive": 20
      },
      "repetitions": 5,
      "actions": {
        "type": "ltminigames:apply_to",
        "target": [
          "participants",
          {
            "type": "limit_entities",
            "count": 5
          }
        ],
        "actions": [
          "ltminigames:spawn_fireworks"
        ]
      }
    }
  ]
}
