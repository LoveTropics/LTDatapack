[
  {
    "type": "lt:common/playing",
    "game_type": "adventure",
    "join_late_with_role": "spectator"
  },
  "lt:common/spectator",
  "lt:mysty/global",
  "lt:mysty/integrations/common",
  "lt:mysty/race/riptide/ruleset",
  {
    "type": "ltminigames:position_players",
    "participants": "player_spawn",
    "spectators": "spectator_spawn",
    "face_region": "spawn_facing"
  },
  {
    "type": "ltminigames:checkpoints",
    "region": "checkpoint",
    "angle": -180.0
  },
  {
    "type": "ltminigames:kill_in_void",
    "void_below_region": "void"
  },
  {
    "type": "ltminigames:set_role",
    "role": "participant",
    "actions": [
      {
        "type": "ltminigames:add_equipment",
        "items": [
          {
            "id": "minecraft:trident",
            "components": {
              "unbreakable": {},
              "ltextras:undroppable": {},
              "enchantments": { "riptide": 3 }
            }
          }
        ]
      },
      {
        "type": "ltminigames:give_effect",
        "effects": [
          {
            "type": "minecraft:water_breathing",
            "seconds": -1,
            "amplifier": 10
          }
        ]
      }
    ]
  },
  {
    "type": "ltminigames:while_in_region",
    "regions": {
      "finish": [
        {
          "type": "ltminigames:set_player_role",
          "role": "spectator"
        },
        {
          "type": "ltminigames:increment_statistic",
          "statistic": "points",
          "amount": 1,
          "scope": "player"
        },
        {
          "type": "ltminigames:increment_statistic",
          "statistic": "points",
          "from_participant_count": true,
          "scope": "player"
        },
        {
          "type": "ltminigames:apply_to",
          "target": "all_players",
          "actions": [
            {
              "type": "ltminigames:play_sound",
              "sound": "minecraft:entity.arrow.hit_player"
            },
            {
              "type": "ltminigames:send_message",
              "message": {
                "translate": "ltminigames.minigame.player_completed_course",
                "color": "gold"
              }
            }
          ]
        },
        "ltminigames:set_total_time"
      ]
    },
    "interval": 2
  },
  {
    "type": "ltminigames:game_end_effects",
    "stop_delay": 600
  },
  {
    "type": "ltminigames:points_sidebar",
    "statistic": "total_time",
    "order": "min",
    "count": 10,
    "title": { "translate": "ltminigames.minigame.mysty.race.riptide", "color": "yellow", "bold": true },
    "header": [{ "translate": "ltminigames.minigame.mysty.race.riptide.header", "color": "gray" }, ""],
    "statistic_holder": "player"
  },
  {
    "type": "ltminigames:place_by_statistic",
    "statistic": "total_time",
    "order": "min"
  },
  {
    "type": "ltminigames:events/game_over",
    "actions": [
      {
        "type": "ltminigames:display_leaderboard",
        "statistic": "total_time",
        "order": "min",
        "length": 6,
        "header": "ltminigames.minigame.results"
      }
    ],
    "target": "all_players"
  },
  {
    "type": "ltminigames:progression",
    "named_points": {
      "start": 0,
      "end": 360,
      "close": 370
    }
  },
  {
    "type": "ltminigames:scheduled_actions",
    "target": "all_players",
    "actions": {
      "end": "ltminigames:end_game",
      "close": "ltminigames:close_game"
    }
  },
  {
    "type": "ltminigames:countdown_effects",
    "target": "end",
    "sound": "minecraft:block.end_portal_frame.fill",
    "seconds": 5,
    "pitch": {
      "start": 1.25,
      "end": 0.25
    }
  },
  {
    "type": "ltminigames:phase_progress_bar",
    "entries": [
      {
        "period": {
          "start": "start",
          "end": "end"
        },
        "text": {
          "translate": "ltminigames.minigame.mysty.race.riptide",
          "color": "green"
        },
        "color": "green",
        "include_time": true,
        "reversed": true
      }
    ]
  }
]
