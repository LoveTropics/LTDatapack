    "show_title": true
  },
  {
    "type": "ltminigames:on_damage",
    "predicate": {
      "type": "minecraft:player"
    },
    "actions": [
      {
        "type": "ltminigames:run_commands",
        "player": ["execute on vehicle run tp ~ ~20 ~"]
      }
    ]
  },
  {
    "type": "ltminigames:scheduled_actions",
    "target": "participants",
    "actions": {
      "start": {
        "actions": {
          "type": "ltminigames:apply_client_state",
          "state": {
            "type": "ltminigames:disable_player_movement"
          }
        },
        "target": "participants"
      },
      "go": [
        {
          "type": "ltminigames:play_sound",
          "sound": "entity.arrow.hit_player",
          "pitch": 1.5
        },
        {
          "type": "ltminigames:show_title",
          "title": {
            "translate": "ltminigames.minigame.turtle_race.go",
            "color": "green"
          },
          "stay": 40
        },
        {
          "type": "ltminigames:remove_client_state",
          "state": "ltminigames:disable_player_movement"
        }
      ]
    }
  },
  {
    "type": "ltminigames:only_tick_in_period",
    "period": {
      "start": "go",
      "end": "end"
    },
    "behavior": [
      {
        "type": "ltminigames:permanent_item",
        "item": {
          "id": "minecraft:crossbow",
