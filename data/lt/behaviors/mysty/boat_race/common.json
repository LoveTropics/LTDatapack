[
  {
    "type": "ltminigames:progression",
    "named_points": {
      "start": 0,
      "go": 10
    }
  },
  {
    "type": "lt:common/playing",
    "game_type": "adventure",
    "join_late_with_role": "spectator"
  },
  {
    "type": "ltminigames:position_players",
    "participants": "player_spawn",
    "spectators": "point_1",
    "face_region": "finish"
  },
  {
    "type": "ltminigames:rider",
    "entity": {
      "type": "minecraft:acacia_boat",
      "tag": {
        "Invulnerable": true
      }
    }
  },
  {
    "type": "ltminigames:countdown_effects",
    "target": "go",
    "sound": "minecraft:entity.arrow.hit_player",
    "seconds": 3,
    "show_title": true
  },
  {
    "type": "ltminigames:on_damage",
    "predicate": {
      "type": "minecraft:player"
    },
    "actions": [
      {
        "type": "ltminigames:run_commands",
        "player": ["execute on vehicle run tp ~ ~20 ~"]
      }
    ]
  },
  {
    "type": "ltminigames:scheduled_actions",
    "target": "all_players",
    "actions": {
      "start": {
        "type": "ltminigames:apply_client_state",
        "state": {
          "type": "ltminigames:disable_player_movement"
        }
      },
      "go": [
        {
          "type": "ltminigames:play_sound",
          "sound": "entity.arrow.hit_player",
          "pitch": 1.5
        },
        {
          "type": "ltminigames:show_title",
          "title": {
            "translate": "ltminigames.minigame.turtle_race.go",
            "color": "green"
          },
          "stay": 40
        },
        {
          "type": "ltminigames:remove_client_state",
          "state": "ltminigames:disable_player_movement"
        }
      ]
    }
  },
  {
    "type": "ltminigames:race_track",
    "path": {
      "start": 1,
      "end": 50,
      "prefix": "point_"
    },
    "lap_count": 3,
    "winner_count": 3,
    "start_time": 200,
    "finish_region": "finish",
    "checkpoint_regions": {}
  },
  {
    "type": "ltminigames:game_end_effects",
    "stop_delay": 400,
    "scheduled_messages": {
      "0": {
        "text": "%winner% completed the race in the shortest amount of time and won the game!",
        "color": "gray"
      }
    }
