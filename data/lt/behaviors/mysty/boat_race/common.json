                        "has_trail": true,
                        "colors": [7427327, 16744576, 7602175, 14395135, 15723519, 16752765, 16711680],
                        "fade_colors": [10742527, 8018431, 14548846, 16770168, 16763791]
                      }
                    ]
                  }
                }
              }
            ],
            "minecraft:damage": 500,
            "ltextras:undroppable": {}
          }
        },
        "interval": 1
