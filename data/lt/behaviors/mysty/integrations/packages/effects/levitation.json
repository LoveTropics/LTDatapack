{
  "type": "ltminigames:donation_package",
  "id": "levitation_package",
  "package_type": "sabotage_package",
  "target": "player",
  "donation_amount": "$amount",
  "receive_actions": [
    "ltminigames:give_player_head_package",
    {
      "type": "ltminigames:give_effect",
      "effects": [
        {
          "type": "minecraft:levitation",
          "seconds": "$seconds",
          "amplifier": "$amplifier"
        }
      ]
    },
    {
      "type": "ltminigames:notify_package",
      "icon": {
        "effect": "minecraft:levitation"
      }
    }
  ]
}
