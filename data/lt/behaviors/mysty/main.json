[
  "lt:mysty/global",
  {
    "type": "ltminigames:set_game_rules",
    "rules": {
      "doDaylightCycle": "false",
      "doWeatherCycle": "false",
      "doMobSpawning": "false",
      "fallDamage": "false",
      "announceAdvancements": "false"
    }
  },
  "ltminigames:disable_hunger",
  "ltminigames:cancel_player_damage",
  "ltminigames:immediate_respawn",
  {
    "type": "ltminigames:position_players",
    "all": ["spawn"]
  },
  {
    "type": "ltminigames:minigame_competition",
    "share_statistics": ["points"],
    "queue": [
      {"game": "lt:mysty/spleef/normal"},
      {"game": "lt:mysty/spleef/coconut"},
      {"game": "lt:mysty/spleef/blindness"},
      {"lobby": {}},
      {"game": "lt:mysty/race/riptide"},
      {"game": "lt:mysty/race/turtle"},
      {"lobby": {}},
      {"game": "lt:mysty/arena/platforms"},
      {"game": "lt:mysty/arena/waves"},
      {"game": "lt:mysty/arena/island"},
      {"lobby": {}},
      {"game": "lt:mysty/race/ice_boat"},
      {"lobby": {}},
      {"game": "lt:mysty/platforms"},
      {"lobby": {}},
      {"game": "lt:mysty/build_battle"}
    ],
    "return_to_lobby_actions": [
      {
        "type": "ltminigames:place_by_statistic",
        "statistic": "points",
        "order": "max"
      },
      {
        "type": "ltminigames:setup_podium",
        "winner_regions": ["winner_1", "winner_2", "winner_3"],
        "loser_region": "spawn"
      }
    ]
  },
  {
    "type": "lt:common/playing",
    "game_type": "adventure",
    "join_late_with_role": "spectator",
    "allow_rejoin": true
  },
  {
    "type": "ltminigames:custom_command",
    "path": ["competition", "score"],
    "permission_level": "overlord",
    "argument": "none",
    "actions": [
      {
        "type": "ltminigames:place_by_statistic",
        "statistic": "points",
        "order": "max"
      },
      {
        "type": "ltminigames:setup_podium",
        "winner_regions": ["winner_1", "winner_2", "winner_3"],
        "loser_region": "spawn",
        "winner_actions": [
          ["lt:mysty/winner/first_place"],
          ["lt:mysty/winner/second_place"],
          ["lt:mysty/winner/third_place"]
        ],
        "loser_actions": {
          "type": "ltminigames:add_equipment",
          "clear": true
        }
      },
      {
        "type": "ltminigames:apply_to",
        "target": "all_players",
        "actions": [
          {
            "type": "ltminigames:display_leaderboard",
            "statistic": "points",
            "order": "max",
            "length": 5,
            "header": {"translate": "ltminigames.minigame.mysty.results"}
          }
        ]
      },
      {
        "type": "ltminigames:delayed",
        "initial_delay": 0,
        "delay": {
          "type": "uniform",
          "min_inclusive": 1,
          "max_inclusive": 20
        },
        "repetitions": 5,
        "actions": {
          "type": "ltminigames:apply_to",
          "target": [
            "participants",
            {"type": "limit_entities", "count": 5}
          ],
          "actions": [
            "ltminigames:spawn_fireworks"
          ]
        }
      }
    ]
  },
  {
    "type": "ltminigames:points_sidebar",
    "statistic": "points",
    "order": "max",
    "count": 10,
    "title": {
      "translate": "ltminigames.minigame.mysty.sidebar",
      "color": "yellow",
      "bold": true
    },
    "header": []
  }
]
