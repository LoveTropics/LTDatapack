[
  {
    "type": "ltminigames:set_game_types",
    "all": "adventure"
  },
  {
    "type": "ltminigames:position_players",
    "all": ["$regions.spawn"]
  },
  "ltminigames:disable_hunger",
  {
    "type": "ltminigames:set_game_rules",
    "rules": {
      "doDaylightCycle": "false",
      "doWeatherCycle": "false",
      "doMobSpawning": "false",
      "fallDamage": "false",
      "announceAdvancements": "false",
      "doImmediateRespawn": "true"
    }
  },
  "ltminigames:immediate_respawn",
  {
    "type": "ltminigames:cancel_player_damage",
    "knockback": true
  },
  {
    "type": "ltminigames:progression",
    "named_points": {
      "end": 60
    }
  },
  {
    "type": "ltminigames:countdown_effects",
    "target": "end",
    "sound": "minecraft:entity.arrow.hit_player",
    "seconds": 3,
    "show_title": false
  },
  {
    "type": "ltminigames:scheduled_actions",
    "target": "all",
    "actions": {
      "end": [
        {
          "type": "ltminigames:play_sound",
          "sound": "minecraft:entity.arrow.hit_player",
          "pitch": 1.5
        },
        "ltminigames:close_game"
      ]
    }
  },
  {
    "type": "ltminigames:phase_progress_bar",
    "entries": [
      {
        "period": [0, "end"],
        "template": {
          "translate": "ltminigames.minigame.starting_in",
          "color": "green"
        },
        "color": "green",
        "reversed": true
      }
    ]
  }
]
