{
  "type": "minecraft:multi_action",
  "title": "Back Screen",
  "can_close_with_escape": true,
  "pause": false,
  "after_action": "none",
  "exit_action": {
    "label": "Go Back",
    "action": {
      "type": "minecraft:show_dialog",
      "dialog": "lt:stage/control"
    }
  },
  "columns": 2,
  "actions": [
    {
      "label": "Rise Screen",
      "action": {
        "type": "minecraft:dynamic/custom",
        "id": "ltextras:run_function",
        "additions": {
          "function": "lt:stage/screen/action/rise",
          "name": "back",
          "amount": 90
        }
      }
    },
    {
      "label": "Lower Screen",
      "action": {
        "type": "minecraft:dynamic/custom",
        "id": "ltextras:run_function",
        "additions": {
          "function": "lt:stage/screen/action/lower",
          "name": "back",
          "amount": 90
        }
      }
    },
    {
      "label": "Play Video",
      "action": {
        "type": "minecraft:run_command",
        "command": "function lt:stage/dialog/dialog/screen/back/video/play with storage lt:stage videos"
      }
    },
    {
      "label": "Clear Video",
      "action": {
        "type": "minecraft:dynamic/custom",
        "id": "ltextras:run_function",
        "additions": {
          "function": "lt:stage/screen/action/clear",
          "name": "back"
        }
      }
    },
    {
      "label": "Change Volume",
      "action": {
        "type": "minecraft:run_command",
        "command": "function lt:stage/dialog/dialog/screen/back/video/volume with entity @e[type=multimedia:screen,tag=utility.stage.screen.name.back,limit=1]"
      }
    }
  ]
}
