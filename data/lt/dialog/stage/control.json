{
  "type": "minecraft:multi_action",
  "title": "Stage Control",
  "can_close_with_escape": true,
  "pause": false,
  "columns": 1,
  "actions": [
    {
      "label": "Curtain Control",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "lt:stage/curtain/control"
      }
    },
    {
      "label": "Screen Control",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": {
          "type": "minecraft:dialog_list",
          "title": "Pick Screen",
          "exit_action": {
            "label": "Go Back",
            "action": {
              "type": "minecraft:show_dialog",
              "dialog": "lt:stage/control"
            }
          },
          "dialogs": ["lt:stage/screen/main", "lt:stage/screen/big", "lt:stage/screen/back"]
        }
      }
    },
    {
      "label": "Add Video",
      "action": {
        "type": "minecraft:show_dialog",
        "dialog": "lt:stage/screen/video/add"
      }
    },
    {
      "label": "Other",
      "action": {
        "type": "minecraft:run_command",
        "command": "function lt:stage/screen/other"
      }
    }
  ]
}
