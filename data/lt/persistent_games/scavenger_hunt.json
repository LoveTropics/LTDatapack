{
  "dimension": "tropicraft:tropics",
  "behaviors": [
    {
      "type": "ltminigames:scavenger_hunt",
      "on_unlock": {
        "sound": "ltminigames:escape_race.generic.yes.3"
      },
      "on_already_unlocked": {
        "sound": "lt:turtle_clash.anti_gravity",
        "messages": [
          {
            "text": "§4❗ §2You have got this clue"
          }
        ]
      },
      "on_missing_previous": {
        "sound": "ltminigames:escape_race.generic.no.3",
        "messages": [
          {
            "translate": "lt.scavenger_hunt.order"
          }
        ]
      },
      "stages": [
        {
          "button_region": "scavenger_1",
          "on_unlock": {
            "commands": [
              "collectible give @s item minecraft:written_book[ltextras:interact_action={click_events:{action:show_dialog,dialog:\"lt:scavenger_hunt/01\"},cancel_event:true},written_book_content={resolved:true,author:\"The Puzzle Whisperer\",pages:[{text:\"1\"}],title:\"Clue 1\"}]"
            ]
          }
        },
        {
          "button_region": "scavenger_2",
          "on_unlock": {
            "commands": [
              "collectible give @s item minecraft:written_book[ltextras:interact_action={click_events:{action:show_dialog,dialog:\"lt:scavenger_hunt/02\"},cancel_event:true},written_book_content={resolved:true,author:\"The Puzzle Whisperer\",pages:[{text:\"2\"}],title:\"Clue 2\"}]"
            ]
          }
        },
        {
          "button_region": "scavenger_3",
          "on_unlock": {
            "commands": [
              "collectible give @s item minecraft:written_book[ltextras:interact_action={click_events:{action:show_dialog,dialog:\"lt:scavenger_hunt/03\"},cancel_event:true},written_book_content={resolved:true,author:\"The Puzzle Whisperer\",pages:[{text:\"3\"}],title:\"Clue 3\"}]"
            ]
          }
        }, {
          "button_region": "scavenger_4",
          "on_unlock": {
            "commands": [
              "collectible give @s item minecraft:written_book[ltextras:interact_action={click_events:{action:show_dialog,dialog:\"lt:scavenger_hunt/04\"},cancel_event:true},written_book_content={resolved:true,author:\"The Puzzle Whisperer\",pages:[{text:\"4\"}],title:\"Clue 4\"}]"
            ]
          }
        }, {
          "button_region": "scavenger_5",
          "on_unlock": {
            "commands": [
              "collectible give @s item minecraft:written_book[ltextras:interact_action={click_events:{action:show_dialog,dialog:\"lt:scavenger_hunt/05\"},cancel_event:true},written_book_content={resolved:true,author:\"The Puzzle Whisperer\",pages:[{text:\"5\"}],title:\"Clue 5\"}]"
            ]
          }
        }, {
          "button_region": "scavenger_6",
          "on_unlock": {
            "commands": [
              "tellraw @a[current_world=true] {translate:\"%s completed the scavenger hunt!\",with:[{selector:\"@s\"}]}",
              "collectible give @s lt:disguise/allay"
            ],
            "messages": [
              {
                "translate": "lt.scavenger_hunt.order"
              }
            ]
          }
        }
      ]
    }
  ]
}
