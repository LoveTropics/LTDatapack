{
  "waiting": {
    "map": {
      "type": "ltminigames:load_map",
      "load_from": "lt:waiting_lobby",
      "dimension_type": "tropicraft:tropics"
    },
    "behaviors": [
      {
        "type": "lt:common/waiting",
        "regions": {
          "spawn": "spawn"
        }
      },
      "lt:teams/red_blue"
    ]
  },

  "name": {"translate": "ltminigames.minigame.eruptive_spleef"},
  "statistics_key": "eruptive_spleef",
  "map": {
    "type": "ltminigames:load_map",
    "load_from": "lt:eruptive_spleef"
  },
  "minimum_participants": 1,
  "maximum_participants": 24,
  "behaviors": [
    {
      "type": "lt:common/playing",
      "game_type": "survival",
      "join_late_with_role": "spectator"
    },
    "ltminigames:teams",
    "ltminigames:spectator_chase",
    {
      "type": "ltminigames:position_players",
      "teams": {
        "blue": ["blue_spawn"],
        "red": ["red_spawn"]
      },
      "face_region": "center",
      "split_by_team": true,
      "all": "center",
      "spectators": ["center"]
    },
    {
      "type": "ltminigames:set_game_rules",
      "rules": {
        "doDaylightCycle": "false",
        "doWeatherCycle": "false",
        "doMobSpawning": "false",
        "fallDamage": "false",
        "announceAdvancements": "false"
      }
    },
    "ltminigames:disable_hunger",
    "ltminigames:cancel_player_attacks",
    {
      "type": "ltminigames:immediate_respawn",
      "role": "participant",
      "respawn_as": "spectator",
      "death_message": {
        "translate": "ltminigames.minigame.survive_the_tide.eliminated",
        "color": "gray"
      },
      "drop_inventory": false
    },
    {
      "type": "ltminigames:last_remaining_win_trigger",
      "last_team": true
    },
    {
      "type": "ltminigames:set_role",
      "role": "participant",
      "action": {
        "type": "ltminigames:add_equipment",
        "items": [
          {
            "id": "minecraft:flint_and_steel",
            "components": {
              "unbreakable": {},
              "ltextras:undroppable": {}
            }
          }
        ],
        "head": {
          "id": "minecraft:leather_helmet",
          "components": {
            "unbreakable": {},
            "ltextras:undroppable": {},
            "trim": {"material": "gold", "pattern": "wild"}
          }
        },
        "color_by_team": true
      }
    },
    {
      "type": "ltminigames:permanent_item",
      "item": "minecraft:tnt",
      "count": 5,
      "interval": 5
    },
    {
      "type": "ltminigames:scale_damage_from_entity",
      "factor": 0.0,
      "source": "minecraft:tnt"
    },
    {
      "type": "ltminigames:while_in_region",
      "regions": {
        "lava": {
          "type": "ltminigames:damage_player",
          "source": "minecraft:lava",
          "amount": 10.0
        }
      },
      "interval": 1
    },
    {
      "type": "ltminigames:game_end_effects",
      "stop_delay": 200,
      "title": {
        "translate": "ltminigames.minigame.win",
        "color": "gold"
      }
    }
  ]
}
