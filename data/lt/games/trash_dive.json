{
  "name": {
    "translate": "ltminigames.minigame.trash_dive",
    "color": "dark_green"
  },
  "statistics_key": "trash_dive",
  "minimum_participants": 1,
  "maximum_participants": 1000,
  "map": {
    "type": "ltminigames:load_map",
    "load_from": "lt:trash_dive",
    "dimension_type": "tropicraft:tropics"
  },
  "behaviors": [
    {
      "type": "lt:common/playing",
      "game_type": "survival",
      "join_late_with_role": "participant",
      "allow_rejoin": true
    },
    {
      "type": "ltminigames:position_players",
      "all": [
        "spawn"
      ]
    },
    {
      "type": "ltminigames:immediate_respawn",
      "role": "participant",
      "respawn_as": "spectator",
      "death_message": {
        "text": "☠ %message%",
        "color": "gray"
      },
      "drop_inventory": false
    },
    {
      "type": "ltminigames:place_trash",
      "positionData": "lt:maps/trash.bin",
      "centerY": 75,
      "range": 50,
      "density": 2
    },
    "ltminigames:trash_collection",
    {
      "type": "ltminigames:points_sidebar",
      "statistic": "trash_collected",
      "order": "max",
      "count": 5,
      "title": {
        "translate": "ltminigames.minigame.trash_dive.sidebar.title",
        "color": "blue",
        "bold": true
      },
      "header": [
        {
          "translate": "ltminigames.minigame.trash_dive.sidebar.instruction",
          "color": "green"
        },
        {
          "translate": "ltminigames.minigame.trash_dive.sidebar.collected",
          "color": "gray"
        },
        "",
        {
          "translate": "ltminigames.minigame.trash_dive.sidebar.top_players",
          "color": "green"
        }
      ]
    },
    {
      "type": "ltminigames:sum_statistic",
      "statistic": "trash_collected"
    },
    {
      "type": "ltminigames:place_by_statistic",
      "statistic": "points",
      "order": "max"
    },
    {
      "type": "ltminigames:display_leaderboard_on_finish",
      "statistic": "trash_collected",
      "order": "max",
      "length": 5
    },
    {
      "type": "ltminigames:progression",
      "named_points": {
        "start": 0,
        "end": 300,
        "close": 310
      }
    },
    {
      "type": "ltminigames:scheduled_actions",
      "target": "all_players",
      "actions": {
        "end": "ltminigames:end_game",
        "close": "ltminigames:close_game"
      }
    },
    {
      "type": "ltminigames:countdown_effects",
      "target": "end",
      "sound": "minecraft:block.end_portal_frame.fill",
      "seconds": 5,
      "pitch": {
        "start": 1.25,
        "end": 0.25
      }
    },
    {
      "type": "ltminigames:phase_progress_bar",
      "entries": [
        {
          "period": {
            "start": "start",
            "end": "end"
          },
          "text": {
            "translate": "ltminigames.minigame.trash_dive",
            "color": "green"
          },
          "color": "green",
          "include_time": true,
          "reversed": true
        }
      ]
    },
    "ltminigames:disable_hunger",
    {
      "type": "ltminigames:set_role",
      "role": "participant",
      "actions": {
        "type": "ltminigames:add_equipment",
        "feet": "tropicraft:pink_scuba_flippers"
      }
    },
    {
      "type": "ltminigames:set_xp_to_statistic",
      "statistic": "trash_collected"
    },
    "lt:common/spectator",
    {
      "type": "lt:fixed_rewards",
      "coins": 10
    },
    "ltminigames:disable_throwing_items"
  ]
}
