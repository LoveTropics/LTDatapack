{
  "name": {
    "translate": "ltminigames.minigame.mcsr"
  },
  "minimum_participants": 1,
  "maximum_participants": 6,
  "donation_type": "participant_contributions",
  "waiting": {
    "map": {
      "type": "ltminigames:load_map",
      "load_from": "lt:games/waiting_lobby",
      "dimension_type": "tropicraft:tropics"
    },
    "behaviors": [
      {
        "type": "lt:common/waiting",
        "regions": {
          "spawn": "spawn"
        }
      }
    ]
  },
  "map": {
    "type": "ltminigames:load_map",
    "load_from": "lt:games/waiting_lobby",
    "dimension_type": "tropicraft:tropics"
  },
  "behaviors": [
    {
      "type": "lt:common/playing",
      "game_type": "survival",
      "join_late_with_role": "spectator",
      "allow_rejoin": true,
      "backend_id": "lt:mcsr",
      "statistics_key": "mcsr"
    },
    {
      "type": "ltminigames:position_players",
      "all": "spawn"
    },
    "ltminigames:disable_hunger",
    {
      "type": "ltminigames:cancel_player_damage",
      "knockback": true
    },
    {
      "type": "ltminigames:set_game_rules",
      "apply_defaults": true,
      "rules": {
        "minecraft:command_blocks_work": false,
        "minecraft:locator_bar": false,
        "minecraft:show_advancement_messages": false,
        "tropicraft:unrestricted_exploding_coconuts": true
      }
    },
    {
      "type": "ltminigames:mcsr/player_worlds",
      "world": "lt:mcsr/world",
      "map": {
        "type": "ltminigames:generator",
        "generator": {
          "type": "minecraft:noise",
          "biome_source": {
            "type": "minecraft:multi_noise",
            "preset": "minecraft:overworld"
          },
          "settings": "minecraft:overworld"
        },
        "dimension": "minecraft:overworld",
        "spawn_region": "spawn",
        "nether": {
          "generator": {
            "type": "minecraft:noise",
            "biome_source": {
              "type": "minecraft:multi_noise",
              "preset": "minecraft:nether"
            },
            "settings": "minecraft:nether"
          },
          "dimension": "minecraft:the_nether"
        },
        "end": {
          "generator": {
            "type": "minecraft:noise",
            "biome_source": {
              "type": "minecraft:the_end"
            },
            "settings": "minecraft:end"
          },
          "dimension": "minecraft:the_end"
        }
      },
      "spawn_region": "spawn"
    },
    "lt:mcsr/bingo",
    "lt:mcsr/shop",
    "lt:mcsr/modifiers",
    "lt:mcsr/donations",
    {
      "type": "ltminigames:mcsr/finish",
      "dragon_kill": true,
      "full_bingo_card": true
    },
    {
      "type": "ltminigames:progression",
      "named_points": {
        "start": 0,
        "end": 5400
      }
    },
    {
      "type": "ltminigames:scheduled_actions",
      "target": "all_players",
      "actions": {
        "end": "ltminigames:end_game"
      }
    },
    {
      "type": "ltminigames:phase_progress_bar",
      "entries": [
        {
          "period": {
            "start": "start",
            "end": "end"
          },
          "text": {
            "translate": "ltminigames.minigame.mcsr",
            "color": "green"
          },
          "color": "green",
          "include_time": true,
          "reversed": true
        }
      ]
    },
    {
      "type": "ltminigames:game_end_effects",
      "stop_delay": 200
    },
    {
      "type": "ltminigames:events/game_over",
      "actions": [
        {
          "type": "ltminigames:show_title",
          "title": {
            "translate": "ltminigames.minigame.game_over.title",
            "color": "gold"
          },
          "subtitle": {
            "translate": "ltminigames.minigame.game_over.subtitle",
            "color": "gray"
          },
          "fade_in": 10,
          "stay": 60,
          "fade_out": 10
        },
        {
          "type": "ltminigames:play_sound",
          "sound": "minecraft:ui.toast.challenge_complete"
        }
      ],
      "target": "all_players"
    },
    {
      "type": "ltminigames:custom_command",
      "path": [
        "unlock_tiles"
      ],
      "permission_level": "overlord",
      "argument": "none",
      "actions": [
        {
          "type": "ltminigames:bingo/unlock_tiles",
          "count": 3
        }
      ]
    },
    {
      "type": "ltminigames:point_control_commands",
      "statistic": "tropicoins",
      "subcommand": ["coins"]
    },
    {
      "type": "ltminigames:set_difficulty",
      "difficulty": "normal"
    },
    {
      "type": "ltminigames:immediate_respawn",
      "drop_inventory": true,
      "respawn_action": [
        "ltminigames:clear_effects",
        "ltminigames:extinguish_player",
        "ltminigames:reset_hunger"
      ]
    },
    {
      "type": "ltminigames:mcsr/ender_pearl_deviation",
      "modifier": "pearl_deviation",
      "degrees_per_level": 1.0
    },
    {
      "type": "ltminigames:mcsr/attribute_per_level",
      "modifier": "heavy",
      "attribute": "minecraft:gravity",
      "amount_per_level": 0.02,
      "operation": "add_multiplied_base"
    },
    {
      "type": "ltminigames:mcsr/scramble_debug_screen",
      "modifier": "bugged_debug",
      "shuffle_level": 1,
      "swap_sides_level": 3,
      "fake_lines_per_level": 0.5,
      "garble_chance_per_level": 0.05,
      "rescramble_chance_per_level": 0.1,
      "extra_lines": [
        {"level": 2, "line": "Minecraft Dungeons 2 playtime: 0 hours"},
        {"level": 4, "line": "Minecraft Dungeons 2 playtime: 2909 hours"},
        {"level": 3, "line": "Scope: Normal"},
        {"level": 5, "line": "Scope: Expanded"}
      ]
    }
  ]
}
