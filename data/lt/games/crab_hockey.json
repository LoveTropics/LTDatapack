{
  "name": { "translate": "ltminigames.minigame.crab_hockey" },

  "statistics_key": "hockey",
  "map": {
    "type": "ltminigames:load_map",
    "load_from": "lt:crab_hockey"
  },
  "minimum_participants": 1,
  "waiting": {
    "map": {
      "type": "ltminigames:load_map",
      "load_from": "lt:waiting_lobby",
      "dimension_type": "tropicraft:tropics"
    },
    "behaviors": [
      {
        "type": "lt:common/waiting",
        "regions": {
          "spawn": "spawn"
        }
      },
      "lt:teams/red_blue"
    ]
  },
  "behaviors": [
    {
      "type": "lt:common/playing",
      "game_type": "adventure",
      "join_late_with_role": "spectator"
    },
    "ltminigames:teams",
    {
      "type": "ltminigames:position_players",
      "teams": {
        "red": ["red"],
        "blue": ["blue"]
      },
      "spectators": ["spectators"],
      "face_region": "crab_spawn"
    },
    "lt:crab_hockey/equipment",
    "lt:crab_hockey/intro",
    {
      "type": "ltminigames:progression",
      "named_points": {
        "start": 10,
        "end": 490,
        "close": 500
      }
    },
    {
      "type": "ltminigames:countdown_effects",
      "target": "end",
      "sound": "minecraft:block.end_portal_frame.fill",
      "seconds": 5,
      "pitch": {
        "start": 1.25,
        "end": 0.25
      }
    },
    "lt:crab_hockey/waiting_period",
    {
      "type": "ltminigames:scheduled_actions",
      "target": "all",
      "actions": {
        "end": [
          {
            "type": "ltminigames:play_sound",
            "sound": "minecraft:block.end_portal.spawn",
            "pitch": 0.2
          },
          {
            "type": "ltminigames:show_title",
            "title": {
              "translate": "ltminigames.minigame.game_over.title",
              "color": "red"
            },
            "stay": 60
          },
          "ltminigames:end_game"
        ],
        "close": "ltminigames:close_game"
      }
    },
    {
      "type": "ltminigames:phase_progress_bar",
      "entries": [
        {
          "period": [0, "start"],
          "text": {
            "translate": "ltminigames.minigame.get_ready",
            "color": "yellow"
          },
          "color": "yellow",
          "reversed": true,
          "include_time": true
        },
        {
          "period": ["start", "end"],
          "text": {
            "translate": "ltminigames.minigame.crab_hockey",
            "color": "red"
          },
          "color": "red",
          "include_time": true,
          "reversed": true
        }
      ]
    },
    {
      "type": "ltminigames:phase_triggers/start",
      "actions": [
        {
          "type": "ltminigames:set_statistic",
          "statistic": "crabs",
          "by_player_count": [
            [0, 1],
            [6, 1],
            [7, 2],
            [8, 2],
            [10, 3]
          ]
        }
      ]
    },
    {
      "type": "ltminigames:score_mob_in_goal",
      "target_count_statistic": "crabs",
      "spawn_region": "crab_spawn",
      "scoring_entity": {
        "type": "tropicraft:fiddler_crab",
        "tag": {
          "RollingDownTown": true,
          "Silent": true,
          "Health": 500,
          "active_effects": [
            {
              "id": "minecraft:glowing",
              "show_particles": false,
              "duration": -1
            }
          ],
          "attributes": [
            {
              "id": "minecraft:generic.max_health",
              "base": 500
            },
            {
              "id": "minecraft:generic.knockback_resistance",
              "base": 0.75
            },
            {
              "id": "minecraft:generic.movement_speed",
              "base": 0
            },
            {
              "id": "minecraft:generic.scale",
              "base": 1.5
            }
          ]
        }
      },
      "team_goal_regions": {
        "red": "red_goal",
        "blue": "blue_goal"
      },
      "statistic": "points",
      "score_period": ["start", "end"]
    },
    {
      "type": "ltminigames:place_by_statistic",
      "statistic": "points",
      "order": "max"
    },
    "ltminigames:disable_hunger",
    {
      "type": "ltminigames:set_game_rules",
      "rules": {
        "doDaylightCycle": "false",
        "doWeatherCycle": "false",
        "doMobSpawning": "false",
        "fallDamage": "false",
        "announceAdvancements": "false",
        "doImmediateRespawn": "true"
      }
    },
    "ltminigames:immediate_respawn",
    "ltminigames:spectator_chase",
    {
      "type": "ltminigames:game_finish",
      "actions": {
        "type": "ltminigames:apply_to_player",
        "target": "all",
        "actions": {
          "type": "ltminigames:give_reward",
          "items": ["ltextras:tropicoin"],
          "statistic_binding": {
            "statistic": "points",
            "multiplier": 0.1,
            "from_team": true
          }
        }
      }
    },
    {
      "type": "ltminigames:points_sidebar",
      "statistic": "points",
      "order": "max",
      "count": 2,
      "title": {"translate": "ltminigames.minigame.crab_hockey", "color": "light_purple", "bold": true},
      "header": [
      ]
    },
    "lt:crab_hockey/donations",
    "ltminigames:cancel_player_damage",
    {
      "type": "ltminigames:set_client_state",
      "state": {
        "type": "ltminigames:disable_bobbing"
      }
    },
    {
      "type": "ltminigames:scale_explosion_knockback",
      "factor": 3.0,
      "exploded": {
        "type": "tropicraft:fiddler_crab"
      },
      "exploder": {
        "type": "minecraft:wind_charge"
      }
    }
  ]
}
