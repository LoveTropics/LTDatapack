{
  "name": { "translate": "ltminigames.minigame.crab_hockey" },

  "statistics_key": "hockey",
  "map": {
    "type": "ltminigames:load_map",
    "load_from": "lt:crab_hockey"
  },
  "minimum_participants": 1,
  "waiting": {
    "map": {
      "type": "ltminigames:load_map",
      "load_from": "lt:waiting_lobby",
      "dimension_type": "tropicraft:tropics"
    },
    "behaviors": [
      {
        "type": "lt:common/waiting",
        "regions": {
          "spawn": "spawn"
        }
      },
      "lt:teams/red_blue"
    ]
  },
  "behaviors": [
    {
      "type": "lt:common/playing",
      "game_type": "adventure",
      "join_late_with_role": "spectator"
    },
    "ltminigames:teams",
    {
      "type": "ltminigames:position_players",
      "teams": {
        "red": ["red"],
        "blue": ["blue"]
      },
      "spectators": ["spectators"]
    },
    {
      "type": "ltminigames:set_role",
      "role": "participant",
      "action": {
        "type": "ltminigames:run_commands",
        "player": ["function lt:world_games/hockey/util/give_stick", "function lt:world_games/hockey/util/set_attributes"]
      }
    },
    {
      "type": "ltminigames:timed",
      "length": 6000,
      "countdown_seconds": 5,
      "timer_bar": {
        "translate": "ltminigames.minigame.trash_dive.time_remaining",
        "color": "green"
      }
    },
    {
      "type": "ltminigames:phase_triggers/start",
      "actions": "lt:crab_hockey/spawn_crab"
    },
    {
      "type": "ltminigames:score_mob_in_goal",
      "scoring_entity": "tropicraft:fiddler_crab",
      "score_action": "lt:crab_hockey/spawn_crab",
      "team_goal_regions": {
        "red": "red_goal",
        "blue": "blue_goal"
      },
      "statistic": "points"
    },
    {
      "type": "ltminigames:place_by_statistic",
      "statistic": "points",
      "order": "max",
      "trigger_win": true
    },
    "ltminigames:disable_hunger",
    {
      "type": "ltminigames:set_game_rules",
      "rules": {
        "doDaylightCycle": "false",
        "doWeatherCycle": "false",
        "doMobSpawning": "false",
        "fallDamage": "false",
        "announceAdvancements": "false",
        "doImmediateRespawn": "true"
      }
    },
    {
      "type": "ltminigames:cancel_player_damage",
      "knockback": true
    },
    "ltminigames:immediate_respawn",
    "ltminigames:spectator_chase",
    {
      "type": "lt:fixed_rewards",
      "coins": 5
    }
  ]
}
