            "sound": "minecraft:block.end_portal.spawn",
            "pitch": 0.2
          },
          {
            "type": "ltminigames:show_title",
            "title": {
              "translate": "ltminigames.minigame.game_over.title",
              "color": "red"
            },
            "stay": 60
          },
          "ltminigames:end_game"
        ],
        "close": "ltminigames:close_game"
      }
    },
    {
      "type": "ltminigames:phase_progress_bar",
      "entries": [
        {
          "period": [
            0,
            "start"
          ],
          "text": {
            "translate": "ltminigames.minigame.get_ready",
            "color": "yellow"
          },
          "color": "yellow",
          "reversed": true,
          "include_time": true
        },
        {
          "period": [
            "start",
            "end"
          ],
          "text": {
            "translate": "ltminigames.minigame.crab_hockey",
            "color": "red"
          },
          "color": "red",
          "include_time": true,
          "reversed": true
        }
      ]
    },
    {
      "type": "ltminigames:phase_triggers/start",
