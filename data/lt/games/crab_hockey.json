      "target": "all_players",
      "actions": {
        "type": "ltminigames:give_reward",
        "items": [
          "ltextras:tropicoin"
        ],
        "statistic_binding": {
          "statistic": "points",
          "multiplier": 0.25,
          "from_team": true
        }
      }
    },
    {
      "type": "ltminigames:points_sidebar",
      "statistic": "points",
      "order": "max",
      "count": 2,
      "title": {
        "translate": "ltminigames.minigame.crab_hockey",
        "color": "light_purple",
        "bold": true
      },
      "header": []
    },
    "lt:crab_hockey/donations",
    "ltminigames:cancel_player_damage",
    {
      "type": "ltminigames:set_client_state",
      "state": {
        "type": "ltminigames:disable_bobbing"
      }
    },
    {
      "type": "ltminigames:scale_explosion_knockback",
