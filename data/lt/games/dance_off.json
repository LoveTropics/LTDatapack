{
  "name": {
    "translate": "Dance Off",
    "color": "dark_green"
  },
  "statistics_key": "dance_off",
  "minimum_participants": 1,
  "maximum_participants": 150,
  "map": {
    "type": "ltminigames:load_map",
    "load_from": "lt:games/dance_off"
  },
  "behaviors": [
    {
      "type": "lt:common/playing",
      "game_type": "adventure",
      "join_late_with_role": "spectator"
    },
    "ltminigames:disable_hunger",
    {
      "type": "ltminigames:set_game_rules",
      "rules": {
        "minecraft:command_blocks_work": false,
        "minecraft:locator_bar": false,
        "minecraft:spawn_mobs": false,
        "minecraft:immediate_respawn": true,
        "minecraft:advance_weather": false,
        "minecraft:fall_damage": false,
        "minecraft:advance_time": false,
        "minecraft:show_advancement_messages": false
      }
    },
    {
      "type": "ltminigames:cancel_player_damage",
      "knockback": true
    },
    "lt:common/spectator",
    {
      "type": "ltminigames:dance_off",
      "levels": [
        "lt:lava_chicken"
      ]
    },
    {
      "type": "ltminigames:events/game_over",
      "actions": [
        {
          "type": "ltminigames:play_sound",
          "sound": "minecraft:block.end_portal.spawn",
          "pitch": 0.2
        }
      ],
      "target": "all_players"
    },
    {
      "type": "ltminigames:game_end_effects",
      "stop_delay": 100
    },
    "lt:common/game_over_title"

  ]
}
