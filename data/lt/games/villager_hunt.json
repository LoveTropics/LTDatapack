{
  "name": { "translate": "ltminigames.minigame.villager_hunt" },
  "statistics_key": "villager_hunt",
  "backend_id": "lt:villager_hunt",
  "icon": "ltminigames:textures/gui/minigames/survive_the_tide/icon.png",

  "minimum_participants": 1,
  "maximum_participants": 40,
  "waiting": {
    "map": {
      "type": "ltminigames:load_map",
      "load_from": "lt:waiting_lobby",
      "dimension_type": "tropicraft:tropics"
    },
    "behaviors": [
      {
        "type": "lt:common/waiting",
        "regions": { "spawn": "spawn" }
      },
      "lt:teams/red_blue"
    ]
  },
  "map": {
    "type": "ltminigames:load_map",
    "load_from": "lt:villager_hunt",
    "dimension_type": "tropicraft:tropics"
  },
  "behaviors": [
    {
      "type": "lt:common/playing",
      "game_type": "adventure",
      "join_late_with_role": "spectator"
    },
    "ltminigames:teams",
    {
      "type": "ltminigames:position_players",
      "teams": {
        "red": ["spawn"],
        "blue": ["spawn"]
      },
      "spectators": ["spectators"]
    },
    {
      "type": "ltminigames:last_remaining_win_trigger",
      "last_team": true
    },
    "ltminigames:disable_hunger",
    {
      "type": "ltminigames:set_game_rules",
      "rules": {
        "doDaylightCycle": "false",
        "doWeatherCycle": "false",
        "doMobSpawning": "false",
        "fallDamage": "false",
        "announceAdvancements": "false",
        "doImmediateRespawn": "true"
      }
    },
    {
      "type": "ltminigames:progression",
      "named_points": {
        "start": 10,
        "end": 310,
        "close": 320
      }
    },
    {
      "type": "ltminigames:scheduled_actions",
      "target": "all",
      "actions": {
        "start": [
          {
            "type": "ltminigames:show_title",
            "message": {
              "translate": "ltminigames.minigame.go",
              "color": "green"
            }
          },
          {
            "type": "ltminigames:play_sound",
            "sound": "minecraft:block.respawn_anchor.deplete"
          },
          {
            "type": "ltminigames:spawn_entity_at_regions",
            "entity": {
              "type": "minecraft:villager",
              "tag": {
                "Health": 8.0,
                "IsBaby": false,
                "attributes": [
                  {
                    "id": "generic.max_health",
                    "base": 8
                  }
                ],
                "ArmorItems": [
                  {},
                  {},
                  {},
                  {
                    "id": "minecraft:leather_helmet",
                    "count": 1,
                    "components": {
                      "unbreakable": {}
                    }
                  }
                ]
              }
            },
            "regions_to_spawn_at": ["spawn"],
            "entity_count_per_region": 75
          }
        ]
      }
    },
    {
      "type": "ltminigames:set_role",
      "role": "participant",
      "action": [
        {
          "type": "ltminigames:run_commands",
          "player": ["disguise as minecraft:villager"]
        },
        {
          "type": "ltminigames:add_equipment",
          "head": {
            "id": "minecraft:leather_helmet",
            "components": {
              "unbreakable": {},
              "ltextras:undroppable": {},
              "trim": {
                "material": "gold",
                "pattern": "wild"
              }
            }
          },
          "chest": {
            "id": "minecraft:leather_chestplate",
            "components": {
              "unbreakable": {},
              "ltextras:undroppable": {}
            }
          },
          "color_by_team": true,
          "hotbar_team_items": {
            "red": {
              "id": "minecraft:red_wool",
              "components": {
                "item_name": "\"Red Team\"",
                "ltextras:undroppable": {}
              }
            },
            "blue": {
              "id": "minecraft:blue_wool",
              "components": {
                "item_name": "\"Blue Team\"",
                "ltextras:undroppable": {}
              }
            }
          }
        }
      ]
    }
