{
  "waiting": {
    "map": {
      "type": "ltminigames:load_map",
      "load_from": "lt:waiting_lobby",
      "dimension_type": "tropicraft:tropics"
    },
    "behaviors": [
      {
        "type": "lt:common/waiting",
        "regions": {
          "spawn": "spawn"
        }
      },
      "lt:teams/red_blue"
    ]
  },

  "name": {"translate": "ltminigames.minigame.crafting_bee"},

  "statistics_key": "crafting_bee",
  "map": {
    "type": "ltminigames:load_map",
    "load_from": "lt:crafting_bee",
    "dimension_type": "lt:raised_clouds"
  },

  "minimum_participants": 1,
  "maximum_participants": 24,
  "behaviors": [
    {
      "type": "lt:common/playing",
      "game_type": "adventure",
      "join_late_with_role": "spectator"
    },
    "ltminigames:teams",
    {
      "type": "ltminigames:position_players",
      "teams": {
        "red": ["red"],
        "blue": ["blue"]
      },
      "spectators": ["spectators"]
    },
    "lt:crafting_bee_recipes",
    {
      "type": "ltminigames:set_client_state",
      "state": {
        "type": "ltminigames:hide_recipe_book",
        "message": {"translate": "ltminigames.minigame.crafting_bee.dont_cheat"}
      }
    },
    {
      "type": "ltminigames:game_finish",
      "actions": {
        "type": "ltminigames:apply_to_player",
        "target": "participants",
        "actions": {
          "type": "ltminigames:give_reward",
          "items": ["ltextras:tropicoin"],
          "statistic_binding": {
            "statistic": "items_crafted",
            "multiplier": 3
          }
        }
      }
    },
    "lt:common/announce_game_over",
    {
      "type": "lt:fixed_rewards",
      "coins": 5
    }
  ]
}
