{
  "waiting": {
    "map": {
      "type": "ltminigames:load_map",
      "load_from": "lt:waiting_lobby",
      "dimension_type": "tropicraft:tropics"
    },
    "behaviors": [
      {
        "type": "lt:common/waiting",
        "regions": {
          "spawn": "spawn"
        }
      },
      "lt:teams/red_blue"
    ]
  },

  "name": {"translate": "ltminigames.minigame.crafting_bee"},

  "statistics_key": "crafting_bee",
  "map": {
    "type": "ltminigames:load_map",
    "load_from": "lt:crafting_bee",
    "dimension_type": "lt:raised_clouds"
  },

  "minimum_participants": 1,
  "maximum_participants": 1000,
  "behaviors": [
    {
      "type": "lt:common/playing",
      "game_type": "adventure",
      "join_late_with_role": "spectator",
      "allow_rejoin": true
    },
    {
      "type": "ltminigames:progression"
    },
    {
      "type": "ltminigames:scheduled_actions",
      "target": "all",
      "actions": {
        "1": {
          "type": "ltminigames:send_message",
          "message": {
            "translate": "ltminigames.minigame.crafting_bee.intro1",
            "color": "gold",
            "italic": true
          }
        }
      }
    },
    "ltminigames:teams",
    {
      "type": "ltminigames:position_players",
      "teams": {
        "red": ["red"],
        "blue": ["blue"]
      },
      "spectators": ["spectators"]
    },
    "lt:crafting_bee_recipes",
    {
      "type": "ltminigames:set_client_state",
      "state": {
        "type": "ltminigames:hide_recipe_book",
        "message": {"translate": "ltminigames.minigame.crafting_bee.dont_cheat"}
      }
    },
    {
      "type": "ltminigames:events/game_over",
      "actions": {
        "type": "ltminigames:delayed",
        "delay": 30,
        "target": {
          "type": "ltminigames:player",
          "value": "all"
        },
        "actions": [
          {
            "type": "ltminigames:play_sound",
            "sound": "block.respawn_anchor.deplete",
            "volume": 0.5
          }
        ]
      }
    },
    "lt:common/announce_game_over",
    {
      "type": "ltminigames:game_end_effects",
      "stop_delay": 140
    },
    "lt:common/winner_fireworks",
    "lt:common/winner_glows",
    {
      "type": "ltminigames:game_finish",
      "actions": {
        "type": "ltminigames:apply_to_player",
        "target": "all",
        "actions": {
          "type": "ltminigames:give_reward",
          "items": ["ltextras:tropicoin"],
          "statistic_binding": {
            "statistic": "items_crafted",
            "from_team": true
          }
        }
      }
    }
  ]
}
