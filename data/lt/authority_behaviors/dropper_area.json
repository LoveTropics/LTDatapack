{
  "enter_commands": [
    "tag @s add in.dropper",
    "team join world_game.dropper @s",
    "collectible lock @s",
    "clear @s *[minecraft:custom_data={ParkourBlacklist:1b}]",
    "effect give @s minecraft:invisibility infinite 255 true"
  ],
  "exit_commands": [
    "tag @s remove in.dropper",
    "team remove dropper @s",
    "function lt:game/dropper/gravity/reset",
    "collectible unlock @s",
    "effect clear @s minecraft:invisibility"
  ]
}